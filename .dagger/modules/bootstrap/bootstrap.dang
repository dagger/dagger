"""
Bootstrap check: can Dagger still run its own CI?
"""
type Bootstrap {

  """
  Run a single lint check (go linting) against a dev build of the engine
  """
  goLint(ws: Workspace!): Void @check {
    runChecks(ws, ["golang:lint-all"], include: ["**/*.go", "**/go.mod", "**/go.sum", "dagger.toml", ".dagger/module"])
  }


  """
  Build dagger from source, and check that it can bootstrap its own CI

  Note: this doesn't actually call all CI checks: only a small subset,
  selected for maximum coverage of Dagger features with limited compute expenditure.
  The actual checks being performed is an implementation detail, and should NOT be relied on.
  In other words, don't skip running <foo> just because it happens to be run here!
  """
  pub runChecks(
    """
    The Dagger repository to run CI against
    """
    ws: Workspace!,

    """
    Which checks to run
    """
    checks: [String!],

    include: [String!],
    exclude: [String!]
  ): Void {
    engineDev(ws: ws)
      .playground
      .withMountedDirectory("/ws", ws.directory("/", gitignore: true, include: include, exclude: exclude))
      .withWorkdir("/ws")
      # TODO: change back to `.withExec(["dagger check"] + checks)`
      # The mounted Workspace is a plain snapshot with no .git, so the
      # nested check would make .dagger/modules/ci its context root and reject
      # ../engine-dev. Remove this once the GitRepository inputs are gone
      # from cli-dev/go and bootstrap no longer depends on git-root discovery.
      .withExec([
        "sh", "-c",
        "git init --quiet && exec dagger check \"$@\"",
        "dagger",
      ] + (checks ?? []))
      .sync
    null
  }
}
