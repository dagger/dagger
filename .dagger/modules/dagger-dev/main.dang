"""
A Dagger module to help developer Dagger.
Single use for the dagger open-source repo.
"""
type DaggerDev {

  """
  A base container image for various tasks related to developing Dagger.
  It carries only basic shell tools (git, ripgrep). For example it is used as a base for the playground.
  """
  base: Container! {
    wolfi.
      container(packages: ["apk-tools", "git", "ripgrep"]).
      withEnvVariable("HOME", "/root").
      withWorkdir("$HOME", expand: true)
  }

  """
  Enable experimental GPU support for the Dagger engine
  """
  gpuSupport: Boolean! = false

  """
  Build and run a dev build of the dagger engine, exposing it as a tcp service.
  Connect to it with `DAGGER_ENGINE=tcp://localhost:1234`
  """
  engine(ws: Workspace!): Service! @up {
    engineDev(ws: ws).service(""
      gpuSupport: gpuSupport
    )
  }

  """
  Build an ephemeral environment with the Dagger CLI and engine built from source, installed and ready to use
  """
  playground(ws: Workspace!): Container! {
    engineDev(ws: ws).installClient(base, service: engine(ws))
      # Without Dagger-in-Dagger, the shell gets no session to the outer
      # engine, so the CLI uses the dev engine that installClient configures.
      .withShell(["sh"], disableDaggerInDagger: true)
  }

  """
  Smoke test: build the CLI and engine from source, then load a small module and run its check
  """
  smoke(ws: Workspace!): Void @check {
    playground(ws)
      .withWorkdir("/smoke")
      .withExec(["git", "init"])
      .withNewFile("dagger.toml", """
        [modules.hello]
        source = ".dagger/modules/hello"
        """)
      .withNewFile(".dagger/modules/hello/dagger-module.toml", ```toml
        name = "hello"
        engineVersion = "latest"

        [runtime]
        source = "dang"
      ```)
      .withNewFile(".dagger/modules/hello/main.dang", """
        type Hello {
          ok: Void @check {
            container.from("alpine").withExec(["true"]).sync
            null
          }
        }
        """)
      # Unset the session this exec gets to the engine running it, so the CLI
      # uses the dev engine that installClient configures (see engine-dev's
      # withoutOuterSession).
      .withExec(["env", "-u", "DAGGER_SESSION_PORT", "-u", "DAGGER_SESSION_TOKEN", "dagger", "version"])
      .withExec(["env", "-u", "DAGGER_SESSION_PORT", "-u", "DAGGER_SESSION_TOKEN", "dagger", "check", "-l"])
      .withExec(["env", "-u", "DAGGER_SESSION_PORT", "-u", "DAGGER_SESSION_TOKEN", "dagger", "check"])
      .sync
    null
  }

  """
  Go tools and system dependencies for generating Dagger source files.
  """
  goBase: Container! {
    # The system packages install while the protoc plugins build: Dang
    # evaluates the fields of a {{ }} record at once, and each field syncs
    # so its work runs there.
    let parts = {{
      base: wolfi.container(packages: [
        # FIXME: infer go version from our go.mod (ideally dagger.io/go has a utility for it)
        "go-1.27",
        "ca-certificates",
        "git",
        "build-base",
        "protobuf~35",
        "protobuf-dev~35",
        "clang-22",
        "lld",
        "libbpf-dev",
      ]).sync
      plugins: directory
        .withFile("protoc-gen-go", goTool("google.golang.org/protobuf", "v1.34.2", "cmd/protoc-gen-go"))
        .withFile("protoc-gen-gogo", goTool("github.com/gogo/protobuf", "v1.3.2", "protoc-gen-gogo"))
        .withFile("protoc-gen-gogoslick", goTool("github.com/gogo/protobuf", "v1.3.2", "protoc-gen-gogoslick"))
        .withFile("protoc-gen-gogofaster", goTool("github.com/gogo/protobuf", "v1.3.2", "protoc-gen-gogofaster"))
        .sync
    }}
    parts.base
      .withEnvVariable("HOME", "/root")
      .withEnvVariable("GOPATH", "/go")
      .withEnvVariable("GOBIN", "/usr/local/bin")
      .withEnvVariable("CGO_ENABLED", "0")
      .withEnvVariable("PATH", "/usr/local/bin:$PATH", expand: true)
      .withWorkdir("/app")
      .withDirectory("/usr/local/bin", parts.plugins)
      # FIXME: use new "latest version" API to move tags into the lockfile
      .withDirectory("/opt/proto/github.com/gogo/googleapis", git("https://github.com/gogo/googleapis.git").tag("v1.4.1").tree)
      .withDirectory("/opt/proto/github.com/gogo/protobuf", git("https://github.com/gogo/protobuf.git").tag("v1.3.2").tree)
      # Keep protobuf imports outside the workspace, at any Go module workdir.
      .withNewFile("/usr/local/bin/protoc", """
        #!/bin/sh
        exec /usr/bin/protoc -I . -I /opt/proto -I /usr/include "$@"
        """, permissions: 493)
  }

  # pkg, a main package of the Go module mod at version, as go install
  # pkg@version builds it: by dagger/go's per-package build, from the module's
  # source as the Go module proxy serves it, the same files go install builds.
  # That source is the build's workspace, so the build is keyed by its
  # content. The build image has no C toolchain, so the binary is static.
  let goTool(mod: String!, version: String!, pkg: String!): File! {
    let src = container
      .from("alpine:3.23")
      .withMountedFile("/src.zip", http("https://proxy.golang.org/" + mod + "/@v/" + version + ".zip"))
      .withExec(["unzip", "-q", "/src.zip", "-d", "/out"])
      .directory("/out/" + mod + "@" + version)
      .asWorkspace
    # No tests: a binary build reads none of the module's test records.
    go(version: "1.27", test: ["!**"])
      .module(ws: src, path: pkg)
      .packages(ws: src)
      .get(key: pkg)
      .binary(ws: src)
  }
}
