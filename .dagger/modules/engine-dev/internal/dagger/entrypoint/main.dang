      receiverType: receiverType,
      receiverValue: receiverValue,
      fnName: fnName,
      fnArgs: fnArgs,
    }})
    let result = container
      .from("alpine:3.22")
      .withFile("/usr/local/bin/dispatch", dispatch, permissions: 755)
      .withMountedDirectory("/workspace", currentModule.contextDirectory)
      .withWorkdir("/workspace/" + currentModule.sourceSubpath)
      .withEnvVariable("DAGGER_MODULE_CALL_DIGEST", callDigest ?? "")
      .withExec(
        ["/usr/local/bin/dispatch", "engine-call", "/dagger/result.json"],
        stdin: request,
        experimentalPrivilegedNesting: true,
      )
      .file("/dagger/result.json")
      .contents
    (result :: JSON!)
  }
