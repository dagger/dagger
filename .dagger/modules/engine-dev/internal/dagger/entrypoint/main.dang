  pub call(
    workspace: Workspace!,
    receiverType: String!,
    receiverValue: JSON,
    fnName: String!,
    fnArgs: JSON!,
    callDigest: String,
  ): JSON! {
    let args = Dagger.json.withContents(toString(fnArgs) :: Dagger.JSON!)
    let workspaceID = if (args.fields.contains("ws")) { args.field(["ws"]).asString } else {
      Dagger.json.withContents(toString(receiverValue) :: Dagger.JSON!).field(["__daggerCompilationWorkspace"]).asString
    }
    let callWorkspace = (Dagger.node(id: workspaceID :: Dagger.ID!).{{... on Dagger.Workspace!}}).withWorkdir(currentModule.sourceSubpath.trimPrefix("/"))
    let request = JSON.encode({{receiverType: receiverType, receiverValue: receiverValue, fnName: fnName, fnArgs: fnArgs, workspaceID: workspaceID}})
    let result = container
      .from("alpine:3.22")
      .withFile("/usr/local/bin/dispatch", dispatch(callWorkspace), permissions: 755)
      .withMountedDirectory("/workspace", assembled(callWorkspace))
      .withWorkdir("/workspace/" + callWorkspace.cwd.trimPrefix("/"))
      .withEnvVariable("DAGGER_MODULE_CALL_DIGEST", callDigest ?? "")
      .withExec(
        ["/usr/local/bin/dispatch", "engine-call", "/dagger/result.json"],
        stdin: request,
        experimentalPrivilegedNesting: true,
      )
      .file("/dagger/result.json")
      .contents
    (result :: JSON!)
  }
