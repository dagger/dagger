"""
A module for running the `go` CLI and profiling remote Go processes.
"""
type GoCli {
  sandbox: Container!

  let profileService: Service = null
  let profileClient: Container! = container
  let profileURL: String! = ""

  new(
    base: Container! = container.from("golang:1.26"),
  ) {
    self.sandbox = base
    self
  }

  """
  Compose the Go command and profiling tools onto a base LLM.
  """
  @agent
  agent(base: LLM!): LLM! {
    base.withTools(currentNode)
  }

  """
  Run a `go` command and keep its changes.
  """
  @cache(policy: FunctionCachePolicy.Never)
  go(
    ws: Workspace!,
    """
    Arguments to pass to `go`.
    """
    args: [String!]!,
  ): Changeset! {
    let before = base
      .withDirectory(".", ws.directory("/", gitignore: true))
      .withEnvVariable("CACHEBUST", UUID.v7)
    let after = before
      .withExec(["go"] + args)
      .sync
    after
      .directory(".")
      # Discard spurious changes that Go makes to .git - not sure why this
      # happens, maybe VCS build related? I think it was .git/index?
      .withoutDirectory(".git")
      .changes(before.directory(".").withoutDirectory(".git"))
  }

  """
  Capture one CPU profile with before/after goroutine dumps and metadata into
  path/<sample ID>/ in the workspace. No background service is needed or started.
  Use profileReport(file: "<saved path>/cpu.pprof") to analyze it later, including
  after this session ends. Failed or partial captures return their diagnostics.

  endpoint must be a container-reachable pprof base URL including /debug/pprof/.
  Only one CPU profiler can run on a process: stop any monitor on this target
  before capturing. This tool never stops or replaces an existing monitor.
  """
  profileCapture(
    ws: Workspace!,
    endpoint: String!,
    """CPU sample duration, 1–60 seconds."""
    seconds: Int! = 15,
    """Workspace-relative destination for a new timestamped capture directory."""
    path: String! = "tmp/go-profiles",
  ): Changeset! @cache(policy: FunctionCachePolicy.Never) {
    let destination = profilePath(path)
    let result = profiler
      .withEnvVariable("PROFILE_NONCE", UUID.v7)
      .withExec([
        "go-profiler", "capture", "--endpoint", endpoint,
        "--seconds", toString(seconds), "--dir", "/profiles",
      ])
    let id = result.stdout
    print("Saved profile capture to " + destination + "/" + id + "/. Use profileReport(file: \"" + destination + "/" + id + "/cpu.pprof\") to analyze it.")
    let before = ws.directory("/")
    before.withDirectory(destination, result.directory("/profiles")).changes(before)
  }

  """
  Optionally sample continuously in the background; prefer profileCapture for a
  single window and profileReport(file: ...) for saved files. Captures a
  CPU profile and goroutine dumps before/after each window, retaining a bounded
  history. Returns immediately; profileStatus lists completed sample IDs and
  failures, profileReport analyzes them, and profileSave preserves the raw files.

  Use the container-reachable URL, including /debug/pprof/, not host localhost.
  Refused/reset endpoints are recorded and retried. Only one monitor is active
  at a time; save and stop it before starting another. Profiling has overhead and
  only one CPU profiler may run on the target process at once.
  """
  profileStart(
    ws: Workspace!,
    endpoint: String!,
    """CPU sample duration, 1–60 seconds."""
    seconds: Int! = 15,
    """Pause between captures, 0–300 seconds."""
    interval: Int! = 5,
    """Number of completed samples to retain, 1–100; older files are deleted."""
    retain: Int! = 20,
  ): GoCli! @cache(policy: FunctionCachePolicy.Never) {
    if (profileService != null) {
      raise "A profiler is already running. Use profileSave, then profileStop first."
    }
    if (seconds < 1 or seconds > 60 or interval < 0 or interval > 300 or retain < 1 or retain > 100) {
      raise "Require seconds=1..60, interval=0..300, retain=1..100."
    }
    let runner = profiler
      .withMountedDirectory("/workspace", ws.directory("/", gitignore: true))
      .withEnvVariable("PROFILE_NONCE", UUID.v7)
      .withExposedPort(8080)
    let svc = runner.asService(args: [
      "go-profiler", "serve", "--endpoint", endpoint,
      "--seconds", toString(seconds), "--interval", toString(interval),
      "--retain", toString(retain), "--listen", ":8080", "--dir", "/profiles",
    ]).start
    self.profileService = svc
    self.profileClient = profiler.withServiceBinding("go-profiler", svc)
    self.profileURL = "http://go-profiler:8080"
    print("Profiling " + endpoint + " in the background. Use profileStatus and profileReport; profileSave before stopping. Completion summaries also appear in the service logs.")
    self
  }

  """
  Read the background profiler's current capture, retained sample IDs (newest
  first), timestamps and errors. Live read: does not start a new sample or wait
  for one to finish.
  """
  profileStatus: String! @cache(policy: FunctionCachePolicy.Never) {
    profileExec(["client", "--url", profileURL, "/status"]).stdout
  }

  """
  Analyze a saved workspace file without a service or any target connection.
  Pass file for a CPU .pprof or a goroutine text dump from profileCapture or
  profileSave. Omit file to analyze a retained sample in the optional monitor.
  file cannot be combined with a non-default sample ID.

  Views: cum (cumulative CPU top), flat (self CPU top), list (source lines;
  requires focus), goroutines-before, goroutines-after (read the supplied dump).
  Live CPU reports default to the latest successful sample; explicit sample IDs
  from profileStatus compare windows. focus is a Go regexp for CPU views only.
  list uses current workspace source for files, or the source at monitor start
  for live samples; either may differ from the profiled binary. Output is bounded.
  """
  profileReport(
    ws: Workspace!,
    sample: String! = "latest",
    view: String! = "cum",
    focus: String! = "",
    """Workspace-relative saved profile or goroutine dump; no monitor required."""
    file: String! = "",
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    if (file != "") {
      if (sample != "latest") {
        raise "Choose a saved file or a monitor sample ID, not both."
      }
      profiler
        .withMountedDirectory("/workspace", ws.directory("/"))
        .withEnvVariable("PROFILE_NONCE", UUID.v7)
        .withExec([
          "go-profiler", "report", "--file", profilePath(file),
          "--view", view, "--focus", focus,
        ]).stdout
    } else {
      profileExec([
        "report", "--url", profileURL, "--sample", sample,
        "--view", view, "--focus", focus,
      ]).stdout
    }
  }

  """
  Save the monitor's completed retained profiles, goroutine dumps and metadata
  into a workspace scratch directory. The monitor keeps running; the in-progress
  sample is not included. Save before stopping or before retention evicts a window.
  Files can then be analyzed with go tool pprof or the normal file tools.
  """
  profileSave(
    ws: Workspace!,
    path: String! = "tmp/go-profiles",
  ): Changeset! @cache(policy: FunctionCachePolicy.Never) {
    let destination = profilePath(path)
    let captured = profileExec(["export", "--url", profileURL, "--dir", "/profile-export"])
      .directory("/profile-export")
    let before = ws.directory("/")
    before.withDirectory(destination, captured).changes(before)
  }

  """
  Stop the background profiler. Does not stop or modify the remote Go process.
  Save retained captures with profileSave first: stopping releases their service.
  """
  profileStop: GoCli! @cache(policy: FunctionCachePolicy.Never) {
    if (profileService != null) {
      profileService.stop
    }
    self.profileService = null
    self.profileClient = container
    self.profileURL = ""
    print("Stopped background profiling; remote process left running.")
    self
  }

  let profilePath(path: String!): String! {
    if (path == "" or path.hasPrefix("/") or path.contains("\\") or path.split("/").contains("..") or path.split("/").contains(".")) {
      raise "Profile path must be workspace-relative, without '.', '..', or backslashes."
    }
    path
  }

  let profileExec(args: [String!]!): Container! {
    if (profileService == null) {
      raise "No active profiler. Call profileStart first."
    }
    profileClient
      .withEnvVariable("PROFILE_NONCE", UUID.v7)
      .withExec(["go-profiler"] + args)
  }

  """
  Test the profiling helper's capture, retention, reports and safe export paths.
  """
  profileTests: Void @check {
    base
      .withMountedDirectory("/profiler-src", currentModule.source.directory("profiler"))
      .withWorkdir("/profiler-src")
      .withEnvVariable("GO111MODULE", "off")
      .withExec(["go", "test", "-race", "./..."])
      .sync
    null
  }

  let profiler: Container! {
    base
      .withMountedDirectory("/profiler-src", currentModule.source.directory("profiler"))
      .withExec(["go", "build", "-o", "/usr/local/bin/go-profiler", "/profiler-src/main.go"])
  }

  base: Container! {
    sandbox
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withEnvVariable("GOMODCACHE", "/go/pkg/mod")
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withEnvVariable("GOCACHE", "/root/.cache/go-build")
      .withWorkdir("/workspace")
  }
}
