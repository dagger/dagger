pub description = "Toolchain to develop the Dagger Go SDK"

let goSdkRemote = "https://github.com/dagger/go-sdk"

# Move this pin only to a reviewed github.com/dagger/go-sdk commit for which
# compareCodegen reports no difference: its dagger-go-sdk-codegen generates
# the core bindings that the Go SDK releases.
let goSdkCodegenCommit = "885a03b270bb27357187cebc8074c8c6e0a7b4c3"

let goSdkCodegenImage = "golang:1.26.1-alpine"

# Go builds use every CPU by default; bound them so that generation and its
# comparison stay light beside other work on a shared engine.
let goBuildJobs = "2"

let withBoundedGoBuilds(ctr: Container!): Container! {
  ctr
    .withEnvVariable("GOMAXPROCS", goBuildJobs)
    .withEnvVariable("GOFLAGS", "-p=" + goBuildJobs)
}

let withGoSdkCodegenCore(ctr: Container!): Container! {
  ctr.withExec([
    "dagger-go-sdk-codegen", "core",
    "--output", "./core",
    "--dag-output", "./dag",
    "--introspection-json-path", "/schema.json",
  ])
}

# Mirrors the exclude patterns of engine-dev's New. If the two lists drift,
# sourceDiff reports a clean workspace as differing from its commit.
let engineSourceExclude = [
  "*",
  "!.git",
  "!dagger.json",
  "!**/dagger.json",
  "!dagger.toml",
  "!**/dagger.toml",
  "!**/go.*",
  "!**/*.dang",
  "!core",
  "!engine",
  "!util",
  "!network",
  "!dagql",
  "!analytics",
  "!auth",
  "!cmd",
  "!internal",
  "!sdk",
  "sdk/**/examples",
  "!cmd",
  "!modules",
  "!.dagger",
  "!.changes",
]

# Host syncs and checkouts set metadata such as modification times
# differently, so trees compare by file content and symlink target alone.
let sourceManifest(tree: Directory!): File! {
  container
    .from(goSdkCodegenImage)
    .withMountedDirectory("/src", tree)
    .withWorkdir("/src")
    .withExec(["sh", "-c", """
      set -euo pipefail
      {
        find . -path ./.git -prune -o -type f -exec sha256sum {} +
        find . -path ./.git -prune -o -type l -exec sh -c 'for l; do echo "symlink:$(readlink "$l")  $l"; done' sh {} +
      } | LC_ALL=C sort -k 2 >/manifest
      """])
    .file("/manifest")
}

# Compares the manifest of an engine-dev source, the engine's actual build
# input, with a commit. Any changed, added or deleted engine input fails the
# diff; paths that engine-dev does not build from are ignored.
let sourceDiff(engineManifest: File!, commitTree: Directory!): Container! {
  container
    .from(goSdkCodegenImage)
    .withFile("/engine-source.sha256sum", engineManifest)
    .withFile("/commit-source.sha256sum", sourceManifest(commitTree.filter(exclude: engineSourceExclude)))
    .withExec(["diff", "-u", "/commit-source.sha256sum", "/engine-source.sha256sum"], expect: ReturnType.ANY)
}

# Paths that a schema capture's engine commit may differ in from the
# candidate: generated bindings, this module and Git metadata are not engine
# inputs.
let schemaInputs(tree: Directory!): Directory! {
  tree
    .withoutDirectory(".git")
    .withoutFile("sdk/go/core/core.gen.go")
    .withoutFile("sdk/go/core/codecs.gen.go")
    .withoutFile("sdk/go/dag/dag.gen.go")
    .withoutDirectory(".dagger/modules/go-client-dev")
}

type GoClientDev {
  """
  Workspace with all the files needed to develop the SDK
  """
  pub workspaceDir: Directory! @defaultPath(path: "/") @ignorePatterns(patterns: [
    "*",
    "!sdk/go",
    "!go.mod",
    "!go.sum",
    "!cmd/codegen",
    "!engine/slog",
    "!engine/distconsts",
    "!internal/fsutil",
  ])

  """
  Path of the Go SDK source within the workspace
  """
  pub sourcePath: String! = "sdk/go"

  """
  Workspace
  """
  let ws: Workspace!

  """
  Build a container to run the go toolchain
  """
  pub devContainer: Container! {
    let ctr = go(ws: self.ws, source: workspaceDir)
      .env
      .withWorkdir(sourcePath)
    # "sdk" is an arbitrary name for state persistence
    let engine = engineDev(ws: self.ws)
    engine.installClient(ctr, engine.service("sdk"))
  }

  pub source: Directory! {
    workspaceDir.directory(sourcePath)
  }

  """
  Test the Go SDK
  """
  pub test: Void @check {
    devContainer
      .withExec(["go", "test", "-v", "-skip=TestProvision", "./..."])
      .sync

    null
  }

  """
  Build dagger-go-sdk-codegen at the pinned github.com/dagger/go-sdk commit
  """
  pub goSdkCodegen: File! {
    withBoundedGoBuilds(container.from(goSdkCodegenImage))
      .withEnvVariable("CGO_ENABLED", "0")
      .withEnvVariable("GOTOOLCHAIN", "local")
      .withMountedDirectory(
        "/src",
        git(goSdkRemote).commit(goSdkCodegenCommit).tree.directory("cmd/dagger-go-sdk-codegen"),
      )
      .withWorkdir("/src")
      .withExec(["go", "build", "-mod=readonly", "-trimpath", "-o", "/out/dagger-go-sdk-codegen", "."])
      .file("/out/dagger-go-sdk-codegen")
  }

  """
  Introspect the API of the dev engine, as a JSON file
  """
  pub introspectionJson: File! {
    devContainer
      .withExec(["go", "-C", "../..", "run", "./cmd/codegen", "introspect", "-o", "/schema.json"])
      .file("/schema.json")
  }

  """
  Introspect the dev engine, and record the engine image that answered: the
  commit stamped into its dagger-engine binary, the binary's SHA-256, the
  digest of its root filesystem, and the manifest of the source it was built
  from, which must have the content of the commit
  """
  pub schemaCapture(
    """
    Commit that the dev engine's dagger-engine binary must be stamped with
    """
    commit: String!,
    """
    Git repository of the commit
    """
    sourceRepo: GitRepository! @defaultPath(path: "/"),
    # Rooted at the context directory: dagger.toml loads go-client with
    # legacy-default-path, which resolves a relative default from the
    # workspace root, not from this module.
    script: File! @defaultPath(path: "/.dagger/modules/go-client-dev/capture-schema.sh"),
  ): Directory! {
    let dev = engineDev(ws: self.ws)
    let manifest = sourceManifest(dev.source)
    let source = sourceDiff(manifest, sourceRepo.commit(commit).tree)
    if (source.exitCode != 0) {
      raise "the dev engine builds from a source that differs from " + commit + ":\n" + source.stdout + source.stderr
    }
    # Service builds its engine with this same container call, so this is the
    # image that introspectionJson queried.
    let engine = dev.container
    container
      .from(goSdkCodegenImage)
      .withFile("/capture/schema.json", introspectionJson)
      .withFile("/capture/engine-source.sha256sum", manifest)
      .withNewFile("/capture/engine-rootfs.digest", engine.rootfs.digest + "\n")
      .withNewFile("/capture/engine-commit", commit + "\n")
      .withFile("/engine/dagger-engine", engine.file("/usr/local/bin/dagger-engine"))
      .withMountedFile("/capture-schema.sh", script)
      .withWorkdir("/capture")
      .withExec(["sh", "/capture-schema.sh"])
      .directory("/capture")
  }

  """
  Check that comparing an engine source with its commit catches changed,
  untracked and deleted engine inputs, and ignores Git metadata, modification
  times and paths that engine-dev does not build from
  """
  pub sourceDiffTest: Void @check {
    let commitTree = directory
      .withNewFile(".git/HEAD", "ref: refs/heads/main\n")
      .withNewFile("README.md", "not an engine input\n")
      .withNewFile("core/schema.go", "package core\n")
      .withNewFile("engine/engine.go", "package engine\n")
      .withSymlink("schema.go", "core/link.go")
    let clean = commitTree
      .withoutDirectory(".git")
      .withNewFile(".git", "gitdir: /worktrees/candidate\n")
      .withoutFile("README.md")
      .withTimestamps(timestamp: 1)
    if (sourceDiff(sourceManifest(clean), commitTree).exitCode != 0) {
      raise "a clean engine source differs from its commit"
    }
    if (sourceDiff(sourceManifest(clean.withNewFile("core/schema.go", "package core // dirty\n")), commitTree).exitCode == 0) {
      raise "a changed engine input matches its commit"
    }
    if (sourceDiff(sourceManifest(clean.withNewFile("core/untracked.go", "package core\n")), commitTree).exitCode == 0) {
      raise "an untracked engine input matches its commit"
    }
    if (sourceDiff(sourceManifest(clean.withoutFile("engine/engine.go")), commitTree).exitCode == 0) {
      raise "a deleted engine input matches its commit"
    }
    if (sourceDiff(sourceManifest(clean.withoutFile("core/link.go").withSymlink("../engine/engine.go", "core/link.go")), commitTree).exitCode == 0) {
      raise "a retargeted engine symlink matches its commit"
    }
    null
  }

  """
  Regenerate the Go SDK API
  """
  pub generate: Changeset! @generate {
    let ctr = devContainer
      .withFile("/usr/local/bin/dagger-go-sdk-codegen", goSdkCodegen)
      .withMountedFile("/schema.json", introspectionJson)
    withGoSdkCodegenCore(ctr)
      .withExec(["go", "mod", "tidy"])
      .directory("../..") # pop back to repo root
      .changes(workspaceDir)
  }

  """
  Check that releasing works, without actually releasing
  """
  pub releaseDryRun(
    """
    Git repository to fake-release
    """
    sourceRepo: GitRepository! @defaultPath(path: "/"),
    """
    Git tag to fake-release
    """
    sourceTag: String! = "HEAD",
    """
    Git remote to fake-release to
    """
    destRemote: String! = "https://github.com/dagger/dagger-go-sdk.git",
    callback: File! @defaultPath(path: "./git-filter-callback.py"),
  ): Void {
    let version = sourceTag.trimPrefix(sourcePath)
    gitReleaser.dryRun(
      sourceRepo: sourceRepo,
      sourceTag: sourceTag,
      destRemote: destRemote,
      destTag: version,
      sourcePath: sourcePath,
      callback: callback,
    )
  }

  """
  Check that dagger-go-sdk-codegen generates the same core bindings as the
  embedded cmd/codegen of a release candidate, from the same schema, and that
  the candidate commits them
  """
  pub compareCodegen(
    """
    Git repository of the release candidate
    """
    sourceRepo: GitRepository! @defaultPath(path: "/"),
    """
    Git ref of the release candidate
    """
    sourceTag: String!,
    """
    Commit that sourceTag must resolve to
    """
    expectedCommit: String!,
    """
    schemaCapture of an engine built from the release candidate
    """
    schemaCapture: Directory!,
    # Rooted at the context directory, as in schemaCapture.
    script: File! @defaultPath(path: "/.dagger/modules/go-client-dev/compare-codegen.sh"),
  ): String! {
    let commit = sourceRepo.ref(sourceTag).commit
    if (commit != expectedCommit) {
      raise sourceTag + " resolves to " + commit + ", not " + expectedCommit
    }
    let candidate = sourceRepo.commit(commit).tree
    let engineCommit = schemaCapture.file("engine-commit").contents.trimSpace
    let engineTree = sourceRepo.commit(engineCommit).tree
    let provenance = sourceDiff(schemaCapture.file("engine-source.sha256sum"), engineTree)
    if (provenance.exitCode != 0) {
      raise "the schema capture's engine source differs from " + engineCommit + ":\n" + provenance.stdout + provenance.stderr
    }
    let engineSource = if (engineCommit == commit) { "candidate" } else {
      # Compare contents only: checkouts of different commits differ in
      # metadata such as modification times.
      let inputs = container
        .from(goSdkCodegenImage)
        .withMountedDirectory("/engine", schemaInputs(engineTree))
        .withMountedDirectory("/candidate", schemaInputs(candidate))
        .withExec(["diff", "-rq", "/engine", "/candidate"], expect: ReturnType.ANY)
      if (inputs.exitCode != 0) {
        raise "the schema comes from an engine at " + engineCommit + ", whose engine inputs differ from " + commit + ":\n" + inputs.stdout + inputs.stderr
      }
      "candidate with other generated bindings"
    }
    let env = withBoundedGoBuilds(go(ws: self.ws, source: candidate).env).withMountedFile(
      "/schema.json",
      schemaCapture.file("schema.json"),
    )
    let embedded = env
      .withExec(["go", "build", "-o", "/usr/local/bin/codegen", "./cmd/codegen"])
      .withExec([
        "codegen", "generate-library",
        "--output", "./sdk/go",
        "--introspection-json-path", "/schema.json",
      ])
      .directory("sdk/go")
    let external = env
      .withFile("/usr/local/bin/dagger-go-sdk-codegen", goSdkCodegen)
      .withWorkdir("sdk/go")
    container
      .from(goSdkCodegenImage)
      .withMountedFile("/compare-codegen.sh", script)
      .withMountedDirectory("/capture", schemaCapture)
      .withMountedDirectory("/candidate", candidate.directory(sourcePath))
      .withMountedDirectory("/embedded", embedded)
      .withMountedDirectory("/external", withGoSdkCodegenCore(external).directory("."))
      .withMountedDirectory(
        "/external-rerun",
        # a distinct exec, so the rerun does not hit the first run's cache
        withGoSdkCodegenCore(external.withEnvVariable("CODEGEN_RUN", "2")).directory("."),
      )
      .withEnvVariable("CANDIDATE_REF", sourceTag)
      .withEnvVariable("CANDIDATE_COMMIT", commit)
      .withEnvVariable("ENGINE_SOURCE", engineSource)
      .withEnvVariable("GENERATOR_REPO", goSdkRemote)
      .withEnvVariable("GENERATOR_COMMIT", goSdkCodegenCommit)
      .withExec(["sh", "/compare-codegen.sh"])
      .stdout
  }

  """
  Publish the Go SDK
  """
  pub release(
    """
    Source git repository to release
    """
    sourceRepo: GitRepository! @defaultPath(path: "/"),
    """
    Source git tag to release
    """
    sourceTag: String!,
    """
    Target git remote to release to
    """
    destRemote: String! = "https://github.com/dagger/dagger-go-sdk.git",
    githubToken: Secret,
    callback: File! @defaultPath(path: "./git-filter-callback.py"),
  ): Void {
    let version = sourceTag.trimPrefix(sourcePath)
    gitReleaser.release(
      sourceRepo: sourceRepo,
      sourceTag: sourceTag,
      destRemote: destRemote,
      destTag: version,
      sourcePath: sourcePath,
      callback: callback,
      githubToken: githubToken,
    )
  }

  let versionFromTag(tag: String!): String! {
    tag.trimPrefix(sourcePath.trimRight("/") + "/")
  }
}
