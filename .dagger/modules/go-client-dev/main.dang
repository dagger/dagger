pub description = "Toolchain to develop the Dagger Go SDK"

type GoClientDev {
  """
  Workspace with all the files needed to develop the SDK
  """
  pub workspaceDir: Directory! @defaultPath(path: "/") @ignorePatterns(patterns: [
    "*",
    "!sdk/go",
    "!go.mod",
    "!go.sum",
    "!cmd/codegen",
    "!engine/slog",
    "!engine/distconsts",
    "!engine/naming",
    "!internal/fsutil",
    "!util/patternmatcher",
  ])

  """
  Path of the Go SDK source within the workspace
  """
  pub sourcePath: String! = "sdk/go"

  """
  Workspace
  """
  let ws: Workspace!

  """
  Build a container to run the go toolchain
  """
  pub devContainer: Container! {
    let ctr = engineDev(ws: self.ws)
      .goEnv(source: workspaceDir)
      .withWorkdir(sourcePath)
    # "sdk" is an arbitrary name for state persistence
    let engine = engineDev(ws: self.ws)
    engine.installClient(ctr, engine.service("sdk"))
  }

  pub source: Directory! {
    workspaceDir.directory(sourcePath)
  }

  """
  Test the Go SDK
  """
  pub test: Void @check {
    # As the engine's tests run: each package's test binary built by
    # dagger/go's per-package build, and run from its package's directory.
    # The tests never run the go command, so they run with the dev engine's
    # client installed and no Go toolchain.
    let engine = engineDev(ws: self.ws)
    # "sdk" is an arbitrary name for state persistence
    let client = engine
      .installClient(service: engine.service("sdk"))
      .withMountedDirectory("/app", workspaceDir)
    engine.testModule(
      container: client,
      source: workspaceDir,
      module: sourcePath,
      skip: "TestProvision",
      testVerbose: true,
    )
    null
  }

  """
  Regenerate the Go SDK API
  """
  pub generate: Changeset! @generate {
    # As the Go SDK's code generation runs: codegen, on the API schema the
    # introspect tool computes from the engine's source without an engine,
    # loading what sdk/go imports through the export driver from dagger/go's
    # archives, so no go command compiles anything. Generating writes only Go
    # files, never go.mod.
    let engine = engineDev(ws: self.ws)
    let src = engine.source
    let sdk = src.directory(sourcePath).asWorkspace
    let golang = go(version: "1.27")
    let archives = golang
      .module(ws: sdk, path: ".", findUp: false)
      .archives(ws: sdk, dependencies: true, packages: ["."], noTests: true)
    # A Go image: codegen lists sdk/go's module with the go command.
    container
      .from(golang.image(version: "1.27"))
      .withFile("/usr/local/bin/codegen", codegen.binary)
      .withFile("/usr/local/bin/export-driver", engine.exportDriver)
      .withMountedFile("/schema.json", engine.introspectionJson)
      .withMountedDirectory("/gobuild-archives", archives)
      .withEnvVariable("GOPACKAGESDRIVER", "/usr/local/bin/export-driver")
      .withEnvVariable("GOLANGCI_EXPORT_ARCHIVES", "/gobuild-archives")
      .withEnvVariable("GOLANGCI_EXPORT_WORKDIR", "/tmp/export-driver")
      .withEnvVariable("GOLANGCI_EXPORT_COMPILE", "never")
      .withDirectory("/src", src)
      .withWorkdir("/src")
      .withExec(["codegen", "generate-library", "--lang", "go", "--introspection-json-path", "/schema.json", "--output", "./" + sourcePath])
      .directory("/src")
      .changes(src)
  }

  """
  Check that releasing works, without actually releasing
  """
  pub releaseDryRun(
    """
    Git repository to fake-release
    """
    sourceRepo: GitRepository! @defaultPath(path: "/"),
    """
    Git tag to fake-release
    """
    sourceTag: String! = "HEAD",
    """
    Git remote to fake-release to
    """
    destRemote: String! = "https://github.com/dagger/dagger-go-sdk.git",
    callback: File! @defaultPath(path: "./git-filter-callback.py"),
  ): Void {
    let version = sourceTag.trimPrefix(sourcePath)
    gitReleaser.dryRun(
      sourceRepo: sourceRepo,
      sourceTag: sourceTag,
      destRemote: destRemote,
      destTag: version,
      callback: callback,
    )
  }

  """
  Publish the Go SDK
  """
  pub release(
    """
    Source git repository to release
    """
    sourceRepo: GitRepository! @defaultPath(path: "/"),
    """
    Source git tag to release
    """
    sourceTag: String!,
    """
    Target git remote to release to
    """
    destRemote: String! = "https://github.com/dagger/dagger-go-sdk.git",
    githubToken: Secret,
    callback: File! @defaultPath(path: "./git-filter-callback.py"),
  ): Void {
    let version = sourceTag.trimPrefix(sourcePath)
    gitReleaser.release(
      sourceRepo: sourceRepo,
      sourceTag: sourceTag,
      destRemote: destRemote,
      destTag: version,
      sourcePath: sourcePath,
      callback: callback,
      githubToken: githubToken,
    )
  }

  let versionFromTag(tag: String!): String! {
    tag.trimPrefix(sourcePath.trimRight("/") + "/")
  }
}
