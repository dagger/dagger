"""
Maintain a semantic SDL diff in a GitHub pull request's description.
"""
type SdlDiff {
  let githubToken: Secret

  new(githubToken: Secret = null) {
    self.githubToken = githubToken
    self
  }

  @agent
  agent(base: LLM!): LLM! {
    base
      .withTools(currentNode)
      .withSystemPrompt("When asked to open or update a PR that changes public APIs, include a semantic SDL diff in its description. Regenerate and publish the schema snapshot first, then preview and publish the diff with the sdl-diff tool. It compares published commits, not pending edits.")
  }

  """
  Preview or update the SDL diff section of a GitHub PR description. For PRs
  changing public APIs, regenerate and push docs/docs-graphql/schema.graphqls
  first, then preview this tool's output and call again with publish=true.

  Compares the published PR head against its merge base, not local pending
  changes. Ignores formatting and field reordering; includes descriptions by
  default. A reorder-only PR gets an explicit "No semantic API changes" section.
  Only the marked SDL section is replaced; all other description text is kept.
  Refuses malformed markers, oversized descriptions, or concurrent PR edits
  detected before publishing. Publishing edits GitHub: only do so when asked
  to update/open the PR. No code from the remote PR is executed.
  """
  @cache(policy: FunctionCachePolicy.Never)
  updateSchemaDiff(
    ws: Workspace!,
    """Full https://github.com/OWNER/REPO/pull/NUMBER URL."""
    pr: String!,
    """Write the section to GitHub. False previews without modifying the PR."""
    publish: Boolean! = false,
    """Include description-only changes in the semantic diff."""
    descriptions: Boolean! = true,
  ): String! {
    let token = githubToken
    if (token == null) {
      raise "Configure sdl-diff.settings.githubToken (e.g. cmd://gh auth token)."
    }
    let args = ["/usr/local/bin/sdl-diff", "-pr", pr]
    if (publish) { args += ["-update"] }
    if (!descriptions) { args += ["-descriptions=false"] }
    runner(ws)
      .withSecretVariable("GH_TOKEN", token)
      .withEnvVariable("CACHEBUST", UUID.v7)
      .withExec(args)
      .stdout
  }

  let buildBase(ws: Workspace!): Container! {
    container.from("golang:1.26")
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withWorkdir("/src")
      .withDirectory("/src", ws.directory("/hack/sdl-diff", gitignore: true))
  }

  let runner(ws: Workspace!): Container! {
    let binary = buildBase(ws)
      .withEnvVariable("CGO_ENABLED", "0")
      .withExec(["go", "build", "-o", "/out/sdl-diff", "."])
      .file("/out/sdl-diff")
    container.from("alpine:3.23")
      .withExec(["apk", "add", "--no-cache", "git", "ca-certificates"])
      .withFile("/usr/local/bin/sdl-diff", binary)
  }
}
