"""
Test suites to run.

Diagnostics are off by default to avoid verbose log and goroutine dump overhead.
Set the module's diagnostics option to enable verbose test output and dev-engine
stacks at 15 and 25 minutes, for example:
`dagger api call test-split --diagnostics test-workspaces`.
"""
type TestSplit {
  """
  Enable verbose test output and engine goroutine dumps at 15 and 25 minutes
  """
  diagnostics: Boolean! = false

  let dumpAfter: [String!]! = if (self.diagnostics) { ["15m", "25m"] } else { [] }

  """
  Workspace
  """
  let ws: Workspace!

  """
  Lower-level API for running specific tests
  """
  pub testSpecific(
    run: [String!]!,
    ebpfProgs: [String!],
    pkg: String! = "./core/integration",
    race: Boolean,
    timeout: String,
    parallel: Int,
    """
    Run the privileged eBPF tests (Linux 6.15 or newer)
    """
    ebpf: Boolean,
  ): Void {
    engineDev(ws: self.ws).test(parallel: parallel, timeout: timeout, race: race, run: run.join("|"), ebpfProgs: ebpfProgs, pkg: pkg, ebpf: ebpf, testVerbose: self.diagnostics, dumpAfter: self.dumpAfter)
  }

  let testCliEngineSpecific(
    run: [String!]!,
    ebpfProgs: [String!],
    pkg: String! = "./core/integration",
    race: Boolean,
  ): Void {
    engineDev(ws: self.ws)
      .withEngineConfig("worker.oci", [
        "minFreeSpace = \"30%\"",
        "maxUsedSpace = \"50%\"",
      ].join("\n"))
      .test(race: race, run: run.join("|"), ebpfProgs: ebpfProgs, pkg: pkg, testVerbose: self.diagnostics, dumpAfter: self.dumpAfter)
  }

  let testSkip(
    skip: [String!]!,
    ebpfProgs: [String!],
    pkg: String! = "./core/integration",
    race: Boolean,
    parallel: Int,
  ): Void {
    engineDev(ws: self.ws).test(parallel: parallel, race: race, skip: skip.join("|"), ebpfProgs: ebpfProgs, pkg: pkg, testVerbose: self.diagnostics, dumpAfter: self.dumpAfter)
  }

  """
  Base integration tests not assigned to another shard
  """
  pub testBase: Void @check {
    testSkip(
      # Exact exclusions preserve similarly named suites and leave new suites
      # in this catch-all shard until they are explicitly assigned elsewhere.
      skip: [
        "^TestCLI$",
        "^TestCachePersistence$",
        "^TestCall$",
        "^TestClientGenerator$",
        "^TestContainer$",
        "^TestDaggerCMD$",
        "^TestDockerfile$",
        "^TestElixir$",
        "^TestEngine$",
        "^TestGo$",
        "^TestInterface$",
        "^TestJava$",
        "^TestLLM$",
        "^TestLocalCache$",
        "^TestModule$",
        "^TestModuleConfig$",
        "^TestModuleDefinitionSuite$",
        "^TestModuleLoading$",
        "^TestPHP$",
        "^TestProvision$",
        "^TestPython$",
        "^TestShell$",
        "^TestTelemetry$",
        "^TestTypescript$",
        "^TestWorkspace$",
        "^TestWorkspaceAPI$",
        "^TestWorkspaceCompat$",
        "^TestWorkspaceLegacyDefaultPath$",
        "^TestWorkspaceMigration$",
        "^TestWorkspaceModules$",
        "^TestWorkspaceSelection$",
        "^TestAgentRestore$",
        "^TestAgents$",
        "^TestArtifacts$",
        "^TestCache$",
        "^TestCallIDRebuild$",
        "^TestCommandHints$",
        "^TestDaggerUpVerifyHarness$",
        "^TestDang$",
        "^TestDirectory$",
        "^TestEnvFile$",
        "^TestGPU$",
        "^TestGenerators$",
        "^TestGit$",
        "^TestHTTP$",
        "^TestHost$",
        "^TestLegacy$",
        "^TestListen$",
        "^TestLocalDir$",
        "^TestLockfile$",
        "^TestRemoteCacheTransferSuite$",
        "^TestRuntimeCodegen$",
        "^TestSecretProvider$",
        "^TestSequential$",
        "^TestType$",
      ],
      race: true,
      parallel: 16,
    )
  }

  """
  Base integration tests assigned to the additional shard
  """
  pub testBaseExtra: Void @check {
    testSpecific(
      run: [
        "^TestAgentRestore$",
        "^TestAgents$",
        "^TestArtifacts$",
        "^TestCache$",
        "^TestCallIDRebuild$",
        "^TestCommandHints$",
        "^TestDaggerUpVerifyHarness$",
        "^TestDang$",
        "^TestDirectory$",
        "^TestEnvFile$",
        "^TestGPU$",
        "^TestGenerators$",
        "^TestGit$",
        "^TestHTTP$",
        "^TestHost$",
        "^TestLegacy$",
        "^TestListen$",
        "^TestLocalDir$",
        "^TestLockfile$",
        "^TestRemoteCacheTransferSuite$",
        "^TestRuntimeCodegen$",
        "^TestSecretProvider$",
        "^TestSequential$",
        "^TestType$",
      ],
      race: true,
      parallel: 16,
    )
  }

  """
  Package patterns covered by the package-test shard
  """
  pub packagePatterns: String! {
    # Match the source tree used by engine-dev tests: workspace-only tools
    # excluded from that tree must not become explicit package arguments.
    go(ws: self.ws, source: engineDev(ws: self.ws).source, race: true, cgo: true).env.withExec([
      "go", "list", "-race", "-f",
      "{{if ne .ImportPath \"github.com/dagger/dagger/core/integration\"}}{{.ImportPath}}{{end}}",
      "./...",
    ]).stdout
  }

  """
  Package tests outside core/integration, with the engine fixtures preserved
  """
  pub testPackages: Void @check {
    testSkip(
      # Preserve the old base exclusions: telemetry and CLI package suites
      # already have dedicated checks, while similarly named tests still run.
      skip: [
        "^TestCLI$",
        "^TestCachePersistence$",
        "^TestCall$",
        "^TestClientGenerator$",
        "^TestContainer$",
        "^TestDaggerCMD$",
        "^TestDockerfile$",
        "^TestElixir$",
        "^TestEngine$",
        "^TestGo$",
        "^TestInterface$",
        "^TestJava$",
        "^TestLLM$",
        "^TestLocalCache$",
        "^TestModule$",
        "^TestModuleConfig$",
        "^TestModuleDefinitionSuite$",
        "^TestModuleLoading$",
        "^TestPHP$",
        "^TestProvision$",
        "^TestPython$",
        "^TestShell$",
        "^TestTelemetry$",
        "^TestTypescript$",
        "^TestWorkspace$",
        "^TestWorkspaceAPI$",
        "^TestWorkspaceCompat$",
        "^TestWorkspaceLegacyDefaultPath$",
        "^TestWorkspaceMigration$",
        "^TestWorkspaceModules$",
        "^TestWorkspaceSelection$",
      ],
      pkg: self.packagePatterns,
      race: true,
      parallel: 4,
    )
  }

  """
  Test Provision
  """
  pub testProvision: Void @check {
    testSpecific(["TestProvision"])
  }

  """
  Test Telemetry
  """
  pub testTelemetry: Void @check {
    # Rendering goldens require their warmup cache to survive session teardown.
    engineDev(ws: self.ws)
      .withEngineConfig("worker.oci", "gc = false")
      .test(run: "^TestTelemetry$", pkg: "./dagql/idtui", testVerbose: self.diagnostics, dumpAfter: self.dumpAfter)
    testSpecific(["^TestTelemetry$"])

    null
  }

  """
  Test Call and Shell
  """
  pub testCallAndShell: Void @check {
    testSpecific(["^TestCall$", "^TestShell$"])
    testSpecific(["^TestDaggerCMD$"], pkg: "./internal/cmd/dagger")

    null
  }

  """
  Test CLI Engine
  """
  pub testCliEngine: Void @check {
    testCliEngineSpecific(["TestCLI", "TestEngine"])
  }

  """
  Test cache persistence
  """
  pub testCachePersistence: Void @check {
    testCliEngineSpecific(["TestCachePersistence"])
  }

  """
  Test local cache
  """
  pub testLocalCache: Void @check {
    testCliEngineSpecific(["TestLocalCache"])
  }

  """
  Test Client Generator
  """
  pub testClientGenerator: Void @check {
    testSpecific(["TestClientGenerator"])
  }

  """
  Test Container
  """
  pub testContainer: Void @check {
    testSpecific(["TestContainer", "TestDockerfile"])
  }

  """
  Test Interface
  """
  pub testInterface: Void @check {
    testSpecific(["TestInterface"])
  }

  """
  Test LLM
  """
  pub testLlm: Void @check {
    testSpecific(["TestLLM"])
  }

  """
  Test Module Runtimes
  """
  pub testModuleRuntimes: Void @check {
    testSpecific(["TestGo", "TestPython", "TestTypescript", "TestElixir", "TestPHP", "TestJava"])
  }

  """
  Test Modules
  """
  pub testModules: Void @check {
    testSpecific(["^TestModule$", "^TestModuleConfig$", "^TestModuleLoading$"])
  }

  """
  Test module definition caching with the race detector.
  This suite starts multiple engines and runs separately from the base shard.
  """
  pub testModuleDefinitions: Void @check {
    testSpecific(["^TestModuleDefinitionSuite$"], race: true)
  }

  """
  Test Workspaces
  """
  pub testWorkspaces: Void @check {
    testSpecific(["TestWorkspace"])
  }

  """
  Test eBPF network accounting of engine subprocesses and executor workloads
  in a privileged test container
  """
  pub testEbpf: Void @check {
    testSpecific(["^TestCommandAccounting$", "^TestWorkloadAccounting$"], pkg: "./engine/ebpf/nettracer", ebpf: true)
  }
}
