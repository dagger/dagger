"""
Test suites to run.

Diagnostics are off by default to avoid verbose log and goroutine dump overhead.
Set the module's diagnostics option to enable verbose test output and dev-engine
stacks at 15 and 25 minutes, for example:
`dagger api call test-split --diagnostics test-workspaces`.
"""
type TestSplit {
  """
  Enable verbose test output and engine goroutine dumps at 15 and 25 minutes
  """
  diagnostics: Boolean! = false

  let dumpAfter: [String!]! = if (diagnostics) { ["15m", "25m"] } else { [] }

  """
  Workspace
  """
  let ws: Workspace!

  """
  The dev engine tests run against. Making the cache entries the engine image
  ships starts a separate engine and takes minutes, before the first test; a
  shard's one dev engine builds the same results for its first Go module
  instead. So it ships them only for the shards that need them: tests that
  check them, and shards whose Go modules the engine would otherwise build
  from scratch many times over, in fresh nested engines or in many tests
  loading Go modules at once.
  """
  let devEngine(imageEntries: Boolean! = false): EngineDev! {
    if (imageEntries) {
      engineDev(ws: self.ws).withImageEntries
    } else {
      engineDev(ws: self.ws)
    }
  }

  """
  Lower-level API for running specific tests
  """
  pub testSpecific(
    run: [String!]!,
    ebpfProgs: [String!],
    pkg: String! = "./core/integration",
    race: Boolean,
    timeout: String,
    parallel: Int,
    """
    Run the privileged eBPF tests (Linux 6.15 or newer)
    """
    ebpf: Boolean,
    """
    Run against an engine with the cache entries its image ships
    """
    imageEntries: Boolean! = false,
  ): Void {
    devEngine(imageEntries: imageEntries).test(parallel: parallel, timeout: timeout, race: race, run: run.join("|"), ebpfProgs: ebpfProgs, pkg: pkg, ebpf: ebpf, testVerbose: self.diagnostics, dumpAfter: self.dumpAfter)
  }

  let testCliEngineSpecific(
    run: [String!]!,
    ebpfProgs: [String!],
    pkg: String! = "./core/integration",
    race: Boolean,
    imageEntries: Boolean! = false,
  ): Void {
    devEngine(imageEntries: imageEntries)
      .withEngineConfig("worker.oci", [
        "minFreeSpace = \"30%\"",
        "maxUsedSpace = \"50%\"",
      ].join("\n"))
      .test(race: race, run: run.join("|"), ebpfProgs: ebpfProgs, pkg: pkg, testVerbose: self.diagnostics, dumpAfter: self.dumpAfter)
  }

  let testSkip(
    skip: [String!]!,
    ebpfProgs: [String!],
    pkg: String! = "./core/integration",
    race: Boolean,
    parallel: Int,
    imageEntries: Boolean! = false,
  ): Void {
    devEngine(imageEntries: imageEntries).test(parallel: parallel, race: race, skip: skip.join("|"), ebpfProgs: ebpfProgs, pkg: pkg, testVerbose: self.diagnostics, dumpAfter: self.dumpAfter)
  }

  """
  Base integration tests not assigned to another shard
  """
  pub testBase: Void @check {
    testSkip(
      # Exact exclusions preserve similarly named suites and leave new suites
      # in this catch-all shard until they are explicitly assigned elsewhere.
      skip: [
        "^TestCLI$",
        "^TestCachePersistence$",
        "^TestCall$",
        "^TestContainer$",
        "^TestDaggerCMD$",
        "^TestDockerfile$",
        "^TestElixir$",
        "^TestEngine$",
        "^TestGo$",
        "^TestInterface$",
        "^TestJava$",
        "^TestLLM$",
        "^TestLocalCache$",
        "^TestModule$",
        "^TestModuleConfig$",
        "^TestModuleDefinitionSuite$",
        "^TestModuleLoading$",
        "^TestPHP$",
        "^TestProvision$",
        "^TestPython$",
        "^TestShell$",
        "^TestTelemetry$",
        "^TestTypescript$",
        "^TestWorkspace$",
        "^TestWorkspaceAPI$",
        "^TestWorkspaceCompat$",
        "^TestWorkspaceLegacyDefaultPath$",
        "^TestWorkspaceMigration$",
        "^TestWorkspaceModules$",
        "^TestWorkspaceSelection$",
        "^TestAgentRestore$",
        "^TestAgents$",
        "^TestArtifacts$",
        "^TestCache$",
        "^TestCallIDRebuild$",
        "^TestCommandHints$",
        "^TestDaggerUpVerifyHarness$",
        "^TestDang$",
        "^TestDirectory$",
        "^TestEnvFile$",
        "^TestGPU$",
        "^TestGenerators$",
        "^TestGit$",
        "^TestHTTP$",
        "^TestHost$",
        "^TestLegacy$",
        "^TestListen$",
        "^TestLocalDir$",
        "^TestLockfile$",
        "^TestRemoteCacheTransferSuite$",
        "^TestRuntimeCodegen$",
        "^TestSecretProvider$",
        "^TestSequential$",
        "^TestType$",
      ],
      race: true,
      parallel: 16,
      # Some of its tests load Go modules in fresh nested engines made from
      # this one, or in sessions of their own on it.
      imageEntries: true,
    )
  }

  """
  Base integration tests assigned to the additional shard
  """
  pub testBaseExtra: Void @check {
    testSpecific(
      run: [
        "^TestAgentRestore$",
        "^TestAgents$",
        "^TestArtifacts$",
        "^TestCache$",
        "^TestCallIDRebuild$",
        "^TestCommandHints$",
        "^TestDaggerUpVerifyHarness$",
        "^TestDang$",
        "^TestDirectory$",
        "^TestEnvFile$",
        "^TestGPU$",
        "^TestGenerators$",
        "^TestGit$",
        "^TestHTTP$",
        "^TestHost$",
        "^TestLegacy$",
        "^TestListen$",
        "^TestLocalDir$",
        "^TestLockfile$",
        "^TestRemoteCacheTransferSuite$",
        "^TestRuntimeCodegen$",
        "^TestSecretProvider$",
        "^TestSequential$",
        "^TestType$",
      ],
      race: true,
      parallel: 16,
      # The remote cache transfer suite checks the engine image's entries.
      imageEntries: true,
    )
  }

  """
  Package tests outside core/integration, with the engine fixtures preserved
  """
  pub testPackages: Void @check {
    testSkip(
      # Preserve the old base exclusions: telemetry and CLI package suites
      # already have dedicated checks, while similarly named tests still run.
      skip: [
        "^TestCLI$",
        "^TestCachePersistence$",
        "^TestCall$",
        "^TestContainer$",
        "^TestDaggerCMD$",
        "^TestDockerfile$",
        "^TestElixir$",
        "^TestEngine$",
        "^TestGo$",
        "^TestInterface$",
        "^TestJava$",
        "^TestLLM$",
        "^TestLocalCache$",
        "^TestModule$",
        "^TestModuleConfig$",
        "^TestModuleDefinitionSuite$",
        "^TestModuleLoading$",
        "^TestPHP$",
        "^TestProvision$",
        "^TestPython$",
        "^TestShell$",
        "^TestTelemetry$",
        "^TestTypescript$",
        "^TestWorkspace$",
        "^TestWorkspaceAPI$",
        "^TestWorkspaceCompat$",
        "^TestWorkspaceLegacyDefaultPath$",
        "^TestWorkspaceMigration$",
        "^TestWorkspaceModules$",
        "^TestWorkspaceSelection$",
      ],
      # Every package of the engine's source with tests but core/integration
      pkg: "./... !./core/integration",
      race: true,
      parallel: 4,
    )
  }

  """
  internal/fastbolt, the engine's in-memory replacement for bbolt: its own
  tests with the race detector, a save to a full filesystem, a differential
  test against the real bbolt, and containerd's metadata and snapshot storage
  tests run on it
  """
  pub testFastbolt: Void @check {
    engineDev(ws: self.ws).goEnv(cgo: true)
      .withDirectory("hack/fastbolt-difftest", self.ws.directory("hack/fastbolt-difftest"))
      .withMountedTemp("/small", size: 1048576)
      .withEnvVariable("FASTBOLT_SMALL_FS", "/small")
      .withExec(["sh", "-ec", """
        root=$PWD
        moddir() { GOFLAGS=-mod=mod go mod download -json "$1" | grep '"Dir":' | cut -d'"' -f4; }

        cd "$root/internal/fastbolt"
        go vet ./...
        go test -race -count=1 ./...

        # The real bbolt, renamed to realbolt so both can be imported at once.
        real="$root/hack/fastbolt-difftest/realbolt"
        rm -rf "$real"
        cp -R "$(moddir go.etcd.io/bbolt@v1.4.3)" "$real"
        chmod -R u+w "$real"
        rm -rf "$real/cmd" "$real/tests"
        find "$real" -name '*_test.go' -delete
        sed -i '1s#.*#module realbolt#' "$real/go.mod"
        find "$real" -name '*.go' -exec sed -i 's#"go.etcd.io/bbolt/#"realbolt/#g; s#"go.etcd.io/bbolt"#"realbolt"#g' {} +
        cd "$root/hack/fastbolt-difftest"
        go mod tidy
        go test -count=1 -run TestDifferential ./...
        go test -race -count=1 -run TestConcurrent ./...

        # containerd's own metadata and snapshot storage tests, on the store,
        # at the containerd version the engine uses.
        cd "$root"
        ctd=/tmp/containerd
        cp -R "$(moddir "github.com/containerd/containerd/v2@$(go list -m -f '{{.Version}}' github.com/containerd/containerd/v2)")" "$ctd"
        chmod -R u+w "$ctd"
        cd "$ctd"
        go mod edit -replace "go.etcd.io/bbolt=$root/internal/fastbolt"
        go mod tidy
        go test -count=1 ./core/metadata/... ./core/snapshots/storage/...
        go test -race -count=1 -cpu=1,4,16 ./core/metadata/...
      """])
      .sync
    null
  }

  """
  Test Provision
  """
  pub testProvision: Void @check {
    testSpecific(["TestProvision"])
  }

  """
  Test Telemetry
  """
  pub testTelemetry: Void @check {
    # Rendering goldens require their warmup cache to survive session teardown.
    devEngine
      .withEngineConfig("worker.oci", "gc = false")
      .test(run: "^TestTelemetry$", pkg: "./dagql/idtui", testVerbose: self.diagnostics, dumpAfter: self.dumpAfter)
    testSpecific(["^TestTelemetry$"])

    null
  }

  """
  Test Call and Shell
  """
  pub testCallAndShell: Void @check {
    # Many of their tests load Go modules at once.
    testSpecific(["^TestCall$", "^TestShell$"], imageEntries: true)
    testSpecific(["^TestDaggerCMD$"], pkg: "./internal/cmd/dagger", imageEntries: true)

    null
  }

  """
  Test CLI Engine
  """
  pub testCliEngine: Void @check {
    # TestDagqlCacheEntriesNoLeak loads Go modules in a fresh nested engine
    # made from this one.
    testCliEngineSpecific(["TestCLI", "TestEngine"], imageEntries: true)
  }

  """
  Test cache persistence
  """
  pub testCachePersistence: Void @check {
    # Its tests load Go modules in fresh nested engines made from this one.
    testCliEngineSpecific(["TestCachePersistence"], imageEntries: true)
  }

  """
  Test local cache
  """
  pub testLocalCache: Void @check {
    testCliEngineSpecific(["TestLocalCache"])
  }

  """
  Test Container
  """
  pub testContainer: Void @check {
    # Some of its tests load Go modules in fresh nested engines made from this
    # one.
    testSpecific(["TestContainer", "TestDockerfile"], imageEntries: true)
  }

  """
  Test Interface
  """
  pub testInterface: Void @check {
    # Its tests all load Go modules at once.
    testSpecific(["TestInterface"], imageEntries: true)
  }

  """
  Test LLM
  """
  pub testLlm: Void @check {
    testSpecific(["TestLLM"])
  }

  """
  Test Module Runtimes
  """
  pub testModuleRuntimes: Void @check {
    # Many of its tests load Go modules at once.
    testSpecific(["TestGo", "TestPython", "TestTypescript", "TestElixir", "TestPHP", "TestJava"], imageEntries: true)
  }

  """
  Test Modules
  """
  pub testModules: Void @check {
    testSpecific(["^TestModule$", "^TestModuleConfig$", "^TestModuleLoading$"])
  }

  """
  Test module definition caching with the race detector.
  This suite starts multiple engines and runs separately from the base shard.
  """
  pub testModuleDefinitions: Void @check {
    # TestCachedAcrossClients loads Go modules in fresh nested engines made
    # from this one.
    testSpecific(["^TestModuleDefinitionSuite$"], race: true, imageEntries: true)
  }

  """
  Test Workspaces
  """
  pub testWorkspaces: Void @check {
    testSpecific(["TestWorkspace"])
  }

  """
  Test eBPF network accounting of engine subprocesses and executor workloads,
  and the trees of chains imported onto overlayfs, whose whiteouts and opaque
  directories need privileges, in a privileged test container
  """
  pub testEbpf: Void @check {
    testSpecific(["^TestCommandAccounting$", "^TestWorkloadAccounting$", "^TestImportChainOverlayTree$"], pkg: "./engine/ebpf/nettracer ./engine/snapshots", ebpf: true)
  }

  """
  Test the exec_sched eBPF program's measurement of an exec in a privileged
  test container
  """
  pub testEbpfExecSched: Void @check {
    testSpecific(["^TestExecSched$"], pkg: "./engine/ebpf/execsched", ebpf: true)
  }
}
