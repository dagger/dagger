"""
Test suites to run.

Diagnostics are off by default to avoid verbose log and goroutine dump overhead.
Set the module's diagnostics option to enable verbose test output and dev-engine
stacks at 15 and 25 minutes, for example:
`dagger api call test-split --diagnostics test-workspaces`.
"""
type TestSplit {
  """
  Enable verbose test output and engine goroutine dumps at 15 and 25 minutes
  """
  diagnostics: Boolean! = false

  let dumpAfter: [String!]! = if (self.diagnostics) { ["15m", "25m"] } else { [] }

  """
  Workspace
  """
  let ws: Workspace!

  """
  Lower-level API for running specific tests
  """
  pub testSpecific(
    run: [String!]!,
    ebpfProgs: [String!],
    pkg: String! = "./core/integration",
    race: Boolean,
    timeout: String,
  ): Void {
    engineDev(ws: self.ws).test(timeout: timeout, race: race, run: run.join("|"), ebpfProgs: ebpfProgs, pkg: pkg, testVerbose: self.diagnostics, dumpAfter: self.dumpAfter)
  }

  let testCliEngineSpecific(
    run: [String!]!,
    ebpfProgs: [String!],
    pkg: String! = "./core/integration",
    race: Boolean,
  ): Void {
    engineDev(ws: self.ws)
      .withEngineConfig("worker.oci", [
        "minFreeSpace = \"30%\"",
        "maxUsedSpace = \"50%\"",
      ].join("\n"))
      .test(race: race, run: run.join("|"), ebpfProgs: ebpfProgs, pkg: pkg, testVerbose: self.diagnostics, dumpAfter: self.dumpAfter)
  }

  let testSkip(
    skip: [String!]!,
    ebpfProgs: [String!],
    pkg: String! = "./core/integration",
    race: Boolean,
  ): Void {
    engineDev(ws: self.ws).test(race: race, skip: skip.join("|"), ebpfProgs: ebpfProgs, pkg: pkg, testVerbose: self.diagnostics, dumpAfter: self.dumpAfter)
  }

  """
  Test Base
  """
  pub testBase: Void @check {
    testSkip(
      # Keep this list exact so similarly named unit tests outside the integration
      # package remain in the base shard.
      skip: [
        "^TestCLI$",
        "^TestCachePersistence$",
        "^TestCall$",
        "^TestClientGenerator$",
        "^TestContainer$",
        "^TestDaggerCMD$",
        "^TestDockerfile$",
        "^TestElixir$",
        "^TestEngine$",
        "^TestGo$",
        "^TestInterface$",
        "^TestJava$",
        "^TestLLM$",
        "^TestLocalCache$",
        "^TestModule$",
        "^TestModuleConfig$",
        "^TestModuleLoading$",
        "^TestPHP$",
        "^TestProvision$",
        "^TestPython$",
        "^TestShell$",
        "^TestTelemetry$",
        "^TestTypescript$",
        "^TestWorkspace$",
        "^TestWorkspaceAPI$",
        "^TestWorkspaceCompat$",
        "^TestWorkspaceLegacyDefaultPath$",
        "^TestWorkspaceMigration$",
        "^TestWorkspaceModules$",
        "^TestWorkspaceSelection$",
      ],
      pkg: "./...",
      race: true,
    )
  }

  """
  Test Provision
  """
  pub testProvision: Void @check {
    testSpecific(["TestProvision"])
  }

  """
  Test Telemetry
  """
  pub testTelemetry: Void @check {
    # Rendering goldens require their warmup cache to survive session teardown.
    engineDev(ws: self.ws)
      .withEngineConfig("worker.oci", "gc = false")
      .test(run: "^TestTelemetry$", pkg: "./dagql/idtui", testVerbose: self.diagnostics, dumpAfter: self.dumpAfter)
    testSpecific(["^TestTelemetry$"])

    null
  }

  """
  Test Call and Shell
  """
  pub testCallAndShell: Void @check {
    testSpecific(["^TestCall$", "^TestShell$"])
    testSpecific(["^TestDaggerCMD$"], pkg: "./internal/cmd/dagger")

    null
  }

  """
  Test CLI Engine
  """
  pub testCliEngine: Void @check {
    testCliEngineSpecific(["TestCLI", "TestEngine"])
  }

  """
  Test cache persistence
  """
  pub testCachePersistence: Void @check {
    testCliEngineSpecific(["TestCachePersistence"])
  }

  """
  Test local cache
  """
  pub testLocalCache: Void @check {
    testCliEngineSpecific(["TestLocalCache"])
  }

  """
  Test Client Generator
  """
  pub testClientGenerator: Void @check {
    testSpecific(["TestClientGenerator"])
  }

  """
  Test Container
  """
  pub testContainer: Void @check {
    testSpecific(["TestContainer", "TestDockerfile"])
  }

  """
  Test Interface
  """
  pub testInterface: Void @check {
    testSpecific(["TestInterface"])
  }

  """
  Test LLM
  """
  pub testLlm: Void @check {
    testSpecific(["TestLLM"])
  }

  """
  Test Module Runtimes
  """
  pub testModuleRuntimes: Void @check {
    testSpecific(["TestGo", "TestPython", "TestTypescript", "TestElixir", "TestPHP", "TestJava"])
  }

  """
  Test Modules
  """
  pub testModules: Void @check {
    testSpecific(["TestModule"])
  }

  """
  Test Workspaces
  """
  pub testWorkspaces: Void @check {
    testSpecific(["TestWorkspace"])
  }
}
