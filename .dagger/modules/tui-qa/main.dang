# tui-qa: give a Dagger coding agent the ability to QA its own live TUI.
#
# The `tui-qa` skill drives an interactive `dagger` TUI over tmux; but a
# Dagger-native agent (the `editor` @agent) has no Bash tool, only Dagger-module
# tools. This module reimplements that QA loop as @agent tools, using the
# DAGGER_TUI_CONSOLE affordance (see the `tui-console` skill and
# dagql/idtui/frontend_console.go): a from-source `dagger` CLI serves its live
# pretty TUI over HTTP, and we drive it with GET /screen + POST /key, /type,
# /resize, /zoom.
#
# Shape of the loop (see `start` for the wiring):
#   - build the `dagger` CLI from source (cliDev)
#   - drop it into a small client container run with privileged nesting (so it
#     talks to this session's engine, and `dagger call/check/agent` actually
#     run with the session's LLM auth) at a
#     configurable workdir, with DAGGER_TUI_CONSOLE=:PORT + DAGGER_PROGRESS=tty
#     + PPROF=:PORT+1 (the CLI's standalone pprof/debug server — see
#     internal/cmd/dagger/debug.go — for profiling the live TUI process)
#   - run the command under test as a Service and .start() it (so it persists
#     across tool calls within this dagger session)
#   - hold a small curl client container (bound to that service) as session
#     state; each interaction tool curls the console over HTTP

let defaultWorkdir = "/src"
let defaultPort = 7777

# Where forwarded Dagger Cloud credentials are mounted. The CLI reads its
# credentials from $XDG_CONFIG_HOME/dagger/credentials.json (see configRoot in
# internal/cloud/auth/auth.go), so pointing XDG_CONFIG_HOME at a directory we
# control is all it takes for a forwarded token to be found.
let configHome = "/config"

# Forward Dagger Cloud credentials and user config into a container. A no-op
# when neither is configured.
#
# Mounted as secrets: credentials never land in a filesystem layer, and the
# plaintext is only resolved (from the host, via the secret URI) when an exec
# actually runs. The mounts are read-only; host-side updates are picked up by
# the next tool call.
let withCredentials(
  ctr: Container!,
  credentials: Secret,
  daggerConfig: Secret,
): Container! {
  let configured = if (credentials == null and daggerConfig == null) {
    ctr
  } else {
    ctr.withEnvVariable("XDG_CONFIG_HOME", configHome)
  }
  let withCloud = if (credentials == null) {
    configured
  } else {
    configured.withMountedSecret(
      configHome + "/dagger/credentials.json",
      credentials,
    )
  }
  if (daggerConfig == null) {
    withCloud
  } else {
    withCloud.withMountedSecret(
      configHome + "/dagger/config.toml",
      daggerConfig,
    )
  }
}

type TuiQa {
  # ---- session state (private so it isn't exposed as tools; persists across
  # tool calls the same way editor's `todos` does) --------------------------

  # a minimal curl container bound to the running console service
  let client: Container! = container
  # the started console service (kept so `stop` can tear it down)
  let service: Service = null
  # base URL of the console inside the client container, e.g. http://tui-qa:7777
  let url: String! = ""
  # base URL of the CLI's standalone PPROF debug server, e.g. http://tui-qa:7778
  let pprofUrl: String! = ""

  # The skills shipped alongside this module (skills/<name>/SKILL.md), installed
  # onto the agent's LLM instead of a static system prompt: the model discovers
  # them with ListSkills and reads them with ReadSkill only when relevant, so
  # the TUI-QA workflow never pollutes context until it's actually needed.
  let skills: Directory! = currentModule.source.directory("skills")

  # Dagger Cloud credentials and user-level config forwarded into the CLI under
  # test. Private so secrets are never exposed as fields or tool arguments:
  # they are configuration, not something the model steers per call.
  let cloudCredentials: Secret = null
  let daggerConfig: Secret = null

  new(
    """
    Dagger Cloud credentials for the CLI under test — the contents of the
    host's ~/.config/dagger/credentials.json — so QA'ing commands that talk to
    Cloud (`dagger cloud ...`, Cloud-backed traces) runs authenticated instead
    of logged out.

    Wire it up in dagger.toml settings rather than passing it around:

        [env.dev.modules.tui-qa.settings]
        cloudCredentials = "file://~/.config/dagger/credentials.json"

    Without it, the CLI under test behaves as logged out.
    """
    cloudCredentials: Secret = null,
    """
    User-level Dagger config for the CLI under test — the contents of the
    host's ~/.config/dagger/config.toml. This forwards LLM provider settings
    when the runner connects to a nested engine.
    """
    daggerConfig: Secret = null,
  ) {
    self.cloudCredentials = cloudCredentials
    self.daggerConfig = daggerConfig
    self
  }

  """
  Compose the TUI-QA tools onto a base LLM.
  """
  agent(base: LLM!): LLM! @agent {
    base
      .withTools(currentNode)
      .withSkills(skills)
  }

  """
  Start a live dagger TUI session and expose it for QA.

  Builds the `dagger` CLI from the workspace source, runs it inside a client
  container, and serves its live pretty TUI over HTTP via DAGGER_TUI_CONSOLE.
  After calling this, use `screen` to read the rendered terminal and
  `key`/`type`/`resize`/`zoom` to drive it. Call `stop` when done.

  ONLY THE CLI IS FROM SOURCE BY DEFAULT. Without `engineAddress` the client
  talks to this session's own engine via nesting — the stock engine the session
  runs on, not one built from the workspace. Changes under core/, engine/ or
  anything else engine-side are invisible in that mode. To QA an engine change,
  run the engine-lab start tool first and pass its tcp://<host>:1234 endpoint
  as `engineAddress`, so the TUI drives an engine built from the workspace.

  args is the dagger subcommand to run, already tokenized, WITHOUT the leading
  "dagger" — e.g. ["call", "test"] or ["check"].
  """
  start(
    source: Workspace!,
    """
    The dagger subcommand + flags to run, e.g. ["call", "test"]. Omit "dagger".
    """
    args: [String!]!,
    """
    Working directory inside the container to run the command from. The workspace
    source is mounted here, so this is usually the repo root.
    """
    workingDirectory: String! = defaultWorkdir,
    """
    Port the HTTP TUI console listens on inside the container.
    """
    port: Int! = defaultPort,
    """
    Address of an already-running engine to attach to instead of the session's
    own — e.g. the tcp://<host>:1234 endpoint the engine-lab start tool
    prints. The TUI session then runs against THAT engine, so engine-side
    changes built from the workspace take effect, and its debug endpoints and
    logs observe exactly what the TUI is driving. Required for QA'ing engine
    changes. Nesting is off in this mode, so LLM auth is whatever that engine
    itself is configured with; if an `agent` session cannot authenticate, fall
    back to the default (outer engine, inherited auth) for CLI-only checks.
    """
    engineAddress: String! = "",
    """
    An auto-saved LLM session file to make resumable inside the runner. The
    CLI resolves sessions as $XDG_STATE_HOME/dagger/llm-sessions/<uuid>.json
    (see getSessionDir in internal/cmd/dagger/llm.go), so the file MUST keep
    its <uuid>.json name — it is mounted under that directory verbatim, with
    XDG_STATE_HOME pointed at /state. Resume it by starting with
    args: ["agent", "-r=<uuid>"].
    """
    session: File = null,
  ): TuiQa! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): starting a service is a side effect that must actually run
    # every invocation, not be served stale from the dagql session cache.

    let srcDir = source.directory("/")

    # build the dagger CLI from source
    let cli = cliDev(ws: source, source: srcDir).binary

    # The client container the command under test runs in. Default: a lean
    # client run with experimentalPrivilegedNesting, so it talks to the
    # session's own engine and inherits its LLM auth (required for `agent`).
    # With `engineAddress`: the same lean client, pointed at the existing engine by
    # address instead — that engine is reachable with no service binding
    # because engine-lab starts its service under the session DNS domain, but
    # nothing forwards LLM credentials to it.
    let lean = container
      .from("alpine:3.20")
      .withExec(["apk", "add", "--no-cache", "curl", "git"])

    let nesting = engineAddress == ""

    let base = if (nesting) {
      lean
    } else {
      lean.withEnvVariable("_EXPERIMENTAL_DAGGER_RUNNER_HOST", engineAddress)
    }

    # we overwrite (or install) the CLI with our from-source build.
    let base2 = base
      .withFile("/usr/local/bin/dagger", cli)
      .withDirectory(workingDirectory, srcDir)
      # The workspace snapshot carries no usable .git of its own — at best a
      # worktree pointer file whose target only exists on the real host — but
      # the CLI under test needs a real checkout: without one,
      # Workspace.snapshot can't freeze (ctrl+s fails with "pulling requires
      # a frozen source workspace") and `dagger agent` composes with no
      # tools. Workspace.git.directory is the documented complement: "mount
      # at .git alongside workspace.directory(\"/\") to form a usable
      # checkout".
      .withDirectory(workingDirectory + "/.git", source.git.directory)
      .withWorkdir(workingDirectory)
      .withEnvVariable("DAGGER_TUI_CONSOLE", ":" + toString(port))
      .withEnvVariable("DAGGER_PROGRESS", "tty")
      .withExposedPort(port)
      # PPROF=<addr> makes the CLI serve net/http/pprof (+ expvar, /debug/gc)
      # on its OWN listener (internal/cmd/dagger/debug.go, wired in main.go's
      # PersistentPreRunE) — a separate server from the console, so profiling
      # stays reachable even when the console's consoleMu-holding loop is
      # wedged, which is exactly when the profiling tools below matter.
      .withEnvVariable("PPROF", ":" + toString(port + 1))
      .withExposedPort(port + 1)

    # Resume support: mount an auto-saved LLM session where getSessionDir
    # (internal/cmd/dagger/llm.go) will look for it, keyed by its filename.
    let resumable = if (session == null) {
      base2
    } else {
      base2
        .withEnvVariable("XDG_STATE_HOME", "/state")
        .withMountedFile("/state/dagger/llm-sessions/" + session.name, session)
    }

    # Cloud auth: forwarded from the configured `cloudCredentials` secret so
    # the CLI under test is logged in (no-op when none is configured).
    let runner = withCredentials(resumable, cloudCredentials, daggerConfig)

    # run the command under test as a persistent service serving the console.
    # Short-lived commands (e.g. ["version"]) exit before the console port's
    # healthcheck ever passes, so `.start` fails with an opaque "service
    # exited before healthcheck" error — rescue that by rerunning the command
    # synchronously and reporting its output instead.
    let svc = {
      runner
        .asService(
          args: ["dagger"] + args,
          disableDaggerInDagger: !nesting,
        )
        .start
    } rescue {
      e: Error => {
        let ran = runner
          .withExec(
            ["dagger"] + args,
            expect: ReturnType.ANY,
            disableDaggerInDagger: !nesting,
          ).{{exitCode, combinedOutput}}
        print(`Command exited immediately (exit code ${ran.exitCode}).`)
        print("")
        print(```
          The TUI console never came up; for one-shot commands use the engine-lab dagger tool.

          == OUTPUT ==
        ```)
        print(ran.combinedOutput)
        null
      }
    }

    if (svc == null) {
      # failure path: leave client/service/url unset so later tools still
      # report "No active TUI session. Call the tui-qa start tool first."
      self
    } else {
      # a tiny client we curl the console from, on every interaction tool
      let curlCtr = container
        .from("alpine:3.20")
        .withExec(["apk", "add", "--no-cache", "curl"])
        .withServiceBinding("tui-qa", svc)

      if (engineAddress != "") {
        print("Attached to existing engine at " + engineAddress)
      }
      self.client = curlCtr
      self.service = svc
      self.url = "http://tui-qa:" + toString(port)
      self.pprofUrl = "http://tui-qa:" + toString(port + 1)
      self
    }
  }

  # NOTE: every tool that reads or drives the live console MUST be
  # @cache(policy: FunctionCachePolicy.Never). Without it, dagql memoizes the
  # function result by (object id + field + args) across tool-call queries in
  # the session, so the SECOND call returns the FIRST call's frame — a frozen
  # screen — and the Dang body (incl. the curl) never re-runs. `Never` mixes a
  # per-call random value into the call id, forcing a fresh execution each time.
  """
  Read the current rendered TUI screen (ANSI-stripped, viewport-clipped exactly
  like a real terminal). Call repeatedly to observe progress.
  """
  screen: String! @cache(policy: FunctionCachePolicy.Never) {
    get("/screen")
  }

  """
  Block until the TUI reaches a state, then return the screen like `screen`
  does — instead of polling `screen` in a loop while spans finish. With
  `match`, returns as soon as the rendered (ANSI-stripped) screen matches
  that RE2 regex; without it, returns once the screen has stopped changing
  for `quietSeconds`. Either way it gives up after `timeoutSeconds` (capped
  server-side at 300) and returns the screen as it stands, without erroring —
  inspect the result rather than assuming the condition was reached.
  """
  wait(
    """
    RE2 regex to wait for on the screen, e.g. "DONE|ERROR" or a prompt
    marker. Empty waits for the screen to go quiet instead.
    """
    match: String! = "",
    """
    How long the screen must stay unchanged to count as settled (only used
    when `match` is empty). Note: a screen with running spans keeps
    re-rendering elapsed times, so it only goes quiet once they finish.
    """
    quietSeconds: Int! = 2,
    """
    Give up after this many seconds and return the screen anyway.
    """
    timeoutSeconds: Int! = 60,
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    post(
      "/wait?quiet=" + toString(quietSeconds) + "s&timeout=" + toString(timeoutSeconds) + "s",
      match,
      # let curl outlive the server-side wait instead of cutting it off
      maxTime: timeoutSeconds + 30,
    )
  }

  """
  Apply a key script to the TUI and return the resulting screen. Keys are
  whitespace/comma separated tuist key names: named keys ("enter", "esc",
  "tab", "space", "up", "down", "left", "right", "pgup", "pgdown", ...),
  single characters, or "+"-joined modifier combos ("ctrl+s", "ctrl+c",
  "alt+enter", "shift+tab" — NOT "C-s"); a "key*N" token repeats it. Unknown
  tokens are rejected before any key is applied. Movement/keymap:
  ←↑↓→ / h j k l move · right/l expand · left/h collapse · enter zoom · esc back ·
  r error origin · L logs · +/- verbosity · / search · T tests.
  """
  key(keys: String!): String! @cache(policy: FunctionCachePolicy.Never) {
    post("/key", keys)
  }

  """
  Type a literal string into the TUI (verbatim, not tokenized) — e.g. into the
  "/" search field. Returns the resulting screen.
  """
  typeText(text: String!): String! @cache(policy: FunctionCachePolicy.Never) {
    post("/type", text)
  }

  """
  Resize the terminal to "<cols>x<rows>" (e.g. "120x12"). Either dimension may be
  omitted/0 to keep it (e.g. "x12" changes only rows). Use a small height to
  reproduce overflow-only rendering. Returns the resulting screen.
  """
  resize(size: String!): String! @cache(policy: FunctionCachePolicy.Never) {
    post("/resize", size)
  }

  """
  Zoom straight to a span by its hex id (from `spans`). Returns the screen.
  """
  zoom(spanHex: String!): String! @cache(policy: FunctionCachePolicy.Never) {
    post("/zoom", spanHex)
  }

  """
  List spans currently loaded in the TUI (id / status / name), optionally
  filtered by a name substring. Status is ERROR (span errored), FAIL (caused a
  failure via a link), run, or ok.
  """
  spans(query: String! = ""): String! @cache(policy: FunctionCachePolicy.Never) {
    # URL-encode spaces so multi-word span names (e.g. "load SDK: go") don't
    # produce a malformed URL that curl rejects (exit 3).
    let path = if (query == "") { "/spans" } else {
      "/spans?q=" + query.replace(
        " ",
        "%20",
      )
    }
    get(path)
  }

  """
  Discover agents from a recorded trace or the live console's roster. Returns
  JSON with stable handles, names, observed states, parent handles, and span IDs.
  With `dagger trace <id> -E`, the first extraction request downloads and caches
  the full trace payloads (may take minutes); no engine or agent restore is needed.
  In live sessions only loaded telemetry is represented. States in a recorded
  trace are historical, not live runtimes. Never starts or focuses an agent.
  """
  agents: String! @cache(policy: FunctionCachePolicy.Never) {
    if (url == "") {
      return "No active TUI session. Call the tui-qa start tool first."
    }
    client
      .withEnvVariable("TUI_QA_NONCE", Random.string)
      .withExec(["curl", "-s", "--connect-timeout", "10", "--max-time", "300", url + "/agents"])
      .stdout
  }

  """
  Read an agent's committed transcript as JSON: text, thinking, tool calls,
  results, and message origins. With `dagger trace <id> -E`, decodes the recorded
  checkpoint directly, never evaluating workspace/tool/module recipes. Missing
  or unsupported message data is an error, not silently omitted. In an engine
  session, reads Agent.snapshot without sending, resuming, or invoking tools.

  Filters apply before pagination; checkpoint message indexes and the snapshot
  digest (recorded) or ID (live) are returned. Tool filters select whole messages.
  Text is not terminal-wrapped or truncated. The first recorded-trace request
  downloads the full payloads; subsequent pages reuse them. Live requests read
  the full message list on demand and return only the selected page.
  """
  transcript(
    """
    Stable handle from `agents`, or a unique display name.
    """
    agent: String!,
    """
    user, assistant, or system. Empty includes all non-system messages.
    """
    role: String! = "",
    """
    Exact tool-call name to select, e.g. staff_spawn. Empty selects all.
    """
    tool: String! = "",
    """
    Optional RE2 regex over message text, tool names, and arguments.
    """
    grep: String! = "",
    """
    Matching messages to skip from the oldest; filters apply first.
    """
    offset: Int! = 0,
    """
    Maximum messages to return, from 1 to 100.
    """
    limit: Int! = 20,
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    if (url == "") {
      return "No active TUI session. Call the tui-qa start tool first."
    }
    client
      .withEnvVariable("TUI_QA_NONCE", Random.string)
      .withExec([
        "curl", "-s", "--get", "--connect-timeout", "10", "--max-time", "300",
        "--data-urlencode", "agent=" + agent,
        "--data-urlencode", "role=" + role,
        "--data-urlencode", "tool=" + tool,
        "--data-urlencode", "grep=" + grep,
        "--data-urlencode", "offset=" + toString(offset),
        "--data-urlencode", "limit=" + toString(limit),
        url + "/transcript",
      ])
      .stdout
  }

  """
  Show one span in depth: name, status, error and its origins, timing, the
  dagui flags that shape how the UI treats it (internal, passthrough,
  encapsulation, log/span roll-up, service, …), the parent chain up to the
  root with each ancestor's flags, and its loaded direct children. Get ids
  from `spans`; use this to answer "why is this span hidden / why didn't its
  logs roll up", or to walk up and down from a span.
  """
  span(spanHex: String!): String! @cache(policy: FunctionCachePolicy.Never) {
    get("/span?id=" + spanHex)
  }

  """
  List a span's loaded subtree chronologically, including internal spans:
  span ID, parent ID, start offset from root, wall duration, and name. No logs
  or additional telemetry are fetched: results may be incomplete. Durations
  may overlap and are not CPU self time. Running spans show elapsed time so far.
  Get the required root span hex from `spans`. Reports filtered/capped rows.
  """
  timings(
    root: String!,
    """
    Minimum wall duration, e.g. "10ms" or "1s". Unknown timings are kept.
    """
    minDuration: String! = "0s",
    """
    Maximum chronological rows to return; 0 means unlimited.
    """
    limit: Int! = 200,
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    get("/timings?root=" + root + "&minDuration=" + minDuration
      .replace("%", "%25")
      .replace("+", "%2B")
      .replace(" ", "%20")
      .replace("#", "%23")
      .replace("&", "%26") + "&limit=" + toString(limit))
  }

  """
  Rebuild the encoded dagql ID for a call digest (xxh3:…) from the call
  payloads the TUI has ingested, and write it into the workspace under
  tmp/ids/<hash> — ready to pass to the engine-lab dumpId tool as its `file`
  argument. Returns the path: the blob itself is huge base64 and never worth
  reading. Digests come from engine errors ("load xxh3:…") and the calls tool.
  """
  callId(
    source: Workspace!,
    digest: String!,
  ): Workspace! @cache(policy: FunctionCachePolicy.Never) {
    let encoded = get("/id?dig=" + digest)
    # The console answers errors in prose; a well-formed encoded ID is a
    # single base64 token. Surface errors instead of writing them to a file.
    if (encoded.contains(" ")) {
      print(encoded)
      source
    } else {
      let path = "tmp/ids/" + digest.replace("xxh3:", "").replace("/", "_")
      print(path)
      source.withNewFile(path, encoded)
    }
  }

  """
  Content-search every call payload the TUI has ingested: a regex matched
  against one line per call — "digest field(args) -> Type recv=digest" — with
  full argument literals searched before display truncation. Long strings show
  bounded excerpts, and responses are size-limited. The tool for "which call
  references this path/image/value" and for walking a chain by grepping the
  digest another line names.
  """
  calls(grep: String!): String! @cache(policy: FunctionCachePolicy.Never) {
    get("/calls?grep=" + grep
      .replace("%", "%25")
      .replace("+", "%2B")
      .replace(" ", "%20")
      .replace("#", "%23")
      .replace("&", "%26"))
  }

  # ---- profiling the live TUI process (via its PPROF debug server; same
  # curl conventions as engine-lab's debugGet, but aimed at the CLI process
  # rather than the engine) --------------------------------------------------

  """
  Dump every goroutine's stack in the live TUI process
  (GET /debug/pprof/goroutine?debug=2 on its PPROF debug server). The first
  tool to reach for when the input/render loop seems wedged: it shows what
  each goroutine — including any consoleMu holder — is blocked on. Served on
  a separate listener from the console, so it responds even when the console
  endpoints hang.
  """
  goroutines: String! @cache(policy: FunctionCachePolicy.Never) {
    pprofGet("/debug/pprof/goroutine?debug=2", 60)
  }

  """
  Profile the live TUI process's CPU for `seconds` seconds and return a
  `go tool pprof -top` table (top 40 nodes) — where the input/render loop is
  actually spending its time.
  """
  cpuProfile(
    """
    How long to sample for, e.g. 10 while reproducing a busy loop.
    """
    seconds: Int! = 10,
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    # curl must outlive the server-side collection window by a comfortable
    # margin, hence seconds + 60.
    pprofTop("/debug/pprof/profile?seconds=" + toString(seconds), seconds + 60)
  }

  """
  Snapshot the live TUI process's heap and return a `go tool pprof -top`
  table (top 40 nodes) — what's holding memory.
  """
  heapProfile: String! @cache(policy: FunctionCachePolicy.Never) {
    pprofTop("/debug/pprof/heap", 60)
  }

  """
  List the tools the model in an interactive LLM session (`dagger agent`, the
  shell's prompt mode) currently sees — names, descriptions and schemas,
  verbatim from the live session — so you can verify what the model would see
  without spending an LLM turn asking the agent itself. Errors with 404 until
  such a session is up in the TUI under test.
  """
  toolset: String! @cache(policy: FunctionCachePolicy.Never) {
    get("/toolset")
  }

  """
  Show the console's own endpoint + keymap help.
  """
  help: String! {
    get("/help")
  }

  # A self-call (`tuiQa`) yields the module's own type as it lives in the
  # runtime schema — a Dagger.TuiQa, which carries a GraphQL id and implements
  # Node. Declaring the return as Dagger.TuiQa! (rather than the bare local
  # TuiQa!) makes the annotation match what the self-call actually produces.
  """
  Stop the TUI session and release the underlying service.
  """
  stop: Dagger.TuiQa! @cache(policy: FunctionCachePolicy.Never) {
    if (service != null) {
      service.stop
      print("Stopped TUI session")
    }
    tuiQa
  }

  # ---- helpers ------------------------------------------------------------

  let get(path: String!, maxTime: Int! = 60): String! {
    if (url == "") {
      return "No active TUI session. Call the tui-qa start tool first."
    }
    client
      # bust Dagger's exec cache so each read hits the live console, not a
      # cached identical curl (the screen changes but the inputs wouldn't)
      .withEnvVariable("TUI_QA_NONCE", Random.string)
      .withExec([
        "curl", "-s",
        "--retry", "15", "--retry-delay", "2", "--retry-connrefused",
        "--max-time", toString(maxTime),
        url + path,
      ])
      .stdout
  }

  let post(path: String!, body: String!, maxTime: Int! = 60): String! {
    if (url == "") {
      return "No active TUI session. Call the tui-qa start tool first."
    }
    client
      .withEnvVariable("TUI_QA_NONCE", Random.string)
      .withExec([
        "curl", "-s",
        "--retry", "15", "--retry-delay", "2", "--retry-connrefused",
        "--max-time", toString(maxTime),
        "--data-binary", body,
        url + path,
      ])
      .stdout
  }

  # GET a text endpoint from the CLI's PPROF debug server (goroutine dumps
  # and friends). Same nonce trick as get/post: bust the exec cache so every
  # call observes the live process.
  let pprofGet(path: String!, maxTime: Int!): String! {
    if (pprofUrl == "") {
      return "No active TUI session. Call the tui-qa start tool first."
    }
    client
      .withEnvVariable("TUI_QA_NONCE", Random.string)
      .withExec([
        "curl", "-s",
        "--retry", "5", "--retry-delay", "2", "--retry-connrefused",
        "--max-time", toString(maxTime),
        pprofUrl + path,
      ])
      .stdout
  }

  # GET a binary pprof profile and render it as a `go tool pprof -top` table.
  # The profile is binary protobuf, so curl -o's it to a file rather than
  # stdout; Go profiles are self-symbolized, so the analysis container needs
  # only a Go toolchain, not the profiled binary. -f keeps an HTTP error from
  # masquerading as a (corrupt) profile. No nonce on the pprof exec: its
  # input file differs every capture, so it never replays a stale analysis.
  let pprofTop(path: String!, maxTime: Int!): String! {
    if (pprofUrl == "") {
      return "No active TUI session. Call the tui-qa start tool first."
    }
    let profile = client
      .withEnvVariable("TUI_QA_NONCE", Random.string)
      .withExec([
        "curl", "-sf",
        "--retry", "5", "--retry-delay", "2", "--retry-connrefused",
        "--max-time", toString(maxTime),
        "-o", "/tmp/profile.pb.gz",
        pprofUrl + path,
      ])
      .file("/tmp/profile.pb.gz")
    container
      .from("golang:1.26-alpine")
      .withFile("/tmp/profile.pb.gz", profile)
      .withExec(["go", "tool", "pprof", "-top", "-nodecount=40", "/tmp/profile.pb.gz"])
      .stdout
  }
}
