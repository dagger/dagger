pub description = "Toolchain to develop the Dagger Typescript SDK"

type TypescriptClientDev {
  pub nodeVersionPrevLts: String! = "22.22.0"
  pub nodeVersionLts = "24.13.1"
  pub bunVersion = "1.3.0"

  pub workspaceDir: Directory!
    @defaultPath(path: "/")
    @ignorePatterns(patterns: [
      "*",
      "!sdk/typescript",
      "sdk/typescript/node_modules",
    ])

  pub sourcePath: String! = "sdk/typescript"

  """
  Workspace
  """
  let ws: Workspace!

  pub source: Directory! {
    workspaceDir.directory(sourcePath)
  }

  """
  Check the formatting of the SDK
  """
  pub lintTypescript: Void @check {
    nodejsDevContainer
      .withExec(["yarn", "--cwd", sourcePath, "lint"])
      .sync

    null
  }

  """
  Format the SDK source with prettier via eslint --fix
  """
  pub format: Changeset! @generate {
    nodejsDevContainer
      .withExec(["yarn", "--cwd", sourcePath, "fmt"])
      .directory(".")
      .withoutDirectory(sourcePath + "/node_modules")
      .changes(workspaceDir)
  }

  """
  Check the formatting of Typescript docs snippets
  """
  pub lintDocsSnippets(
    docsWorkspace: Directory! @defaultPath(path: "/") @ignorePatterns(patterns: [
      "*",
      "!**/*.mts",
      "!**/*.mjs",
      "!**/*.ts",
      "!**/*.js",
      "!**/*prettier*",
      "!**/*eslint*",
    ]),
  ): Void @check {
    let path = "docs/current_docs"
    nodejsDevContainer
      # Add docs snippets on top of the already-mounted SDK source
      .withDirectory(".", docsWorkspace)
      .withExec(["yarn", "--cwd", sourcePath, "docs:lint"])
      .sync

    null
  }

  """
  Test the SDK with LTS version of Node
  """
  pub testNodejsLts: Void @check {
    testNodejs(nodeVersionLts)
  }

  """
  Test the SDK with previous LTS version of Node
  """
  pub testNodejsPrevLts: Void @check {
    testNodejs(nodeVersionPrevLts)
  }

  """
  Test the SDK with the given version of NodeJS
  """
  pub testNodejs(nodeVersion: String!): Void {
    daggerEngine(ws: self.ws)
      .installClient(nodejsDevContainer(nodeVersion))
      .withWorkdir(sourcePath)
      .withEnvVariable("NODE_OPTIONS", "--import @dagger.io/mocha/register")
      .withExec(["yarn", "test:node", "-i", "-g", "Automatic Provisioned CLI Binary"])
      .sync

    null
  }

  """
  Test the SDK with BunJS
  """
  pub testBunjs: Void @check {
    daggerEngine(ws: self.ws)
      .installClient(bunjsDevContainer)
      .withWorkdir(sourcePath)
      .withExec(["bun", "test:bun", "-i", "-g", "Automatic Provisioned CLI Binary"])
      .sync

    null
  }

  """
  Generate the Typescript client library
  """
  pub clientLibrary: Changeset! @generate {
    nodejsBase(nodeVersionPrevLts)
      .withMountedDirectory(".", workspaceDir)
      .withExec(["yarn", "--cwd", sourcePath, "install"])
      .withFile("/usr/local/bin/codegen", codegen.binary)
      # Generating needs no engine: the introspection JSON is computed without one.
      .withMountedFile("/schema.json", daggerEngine(ws: self.ws).introspectionJson)
      .withExec(["codegen", "generate-library", "--lang", "typescript", "--introspection-json-path", "/schema.json", "-o", "./sdk/typescript/src/api/"])
      .withExec(["sh", "-c", "yarn --cwd " + sourcePath + " eslint --max-warnings=0 --fix ./src/api/"])
      .directory(".")
      # FIXME: more efficient way to exclude node_modules from the diff?
      .withoutDirectory(sourcePath + "/node_modules")
      # FIXME: since we know this is purely additive, compare to empty dir for more efficient diff?
      .changes(workspaceDir)
  }

  """
  Build the SDK and check it produces a dist/.

  This is what `release` proved on the way to publishing `@dagger.io/dagger`,
  kept after that publish went away: the aggregate is generated per scope by
  dagger/typescript-sdk now, and `@dagger.io/core` is what this repo releases.
  Nothing else here runs the build — the test checks run `yarn test:node` and
  `bun test:bun` against the sources, and the lint check only lints them.
  """
  pub buildTypescript: Void @check {
    nodejsDevContainer
      .withWorkdir(sourcePath)
      .withExec(["npm", "run", "build"])
      .directory("dist")
      .entries

    null
  }

  """
  Where @dagger.io/core lives, relative to the workspace root.
  """
  pub corePath: String! = sourcePath + "/packages/core"

  """
  Regenerate @dagger.io/core's bindings from this repo's engine.

  The engine is the source of truth for the API the bindings describe, so they
  are rendered from this repo's engine and not copied from a dagger/typescript-sdk
  release: an engine can move with nothing in that repo moving, and a copy would
  be stale exactly then. Measured on this tree — rendering against main picked up
  a `disk` option on temporary directories, and later a whole artifact-dimension
  API, that a pinned copy had missed.

  The renderer comes from typescript-sdk's own codegen module, so there is no
  second copy of its build here. The container handed to it is wired to this
  repo's engine with `installClient`, not left to privileged nesting: the
  generator styles identifiers through `Naming.formatIdentifiers` over the
  session it runs in, so nesting would spell the bindings the way the *ambient*
  engine does while the schema came from the dev engine.

  Only client.gen.ts is rendered. connect.ts, core.ts and index.ts are
  hand-written upstream and no renderer produces them, so they come from the
  pinned release. package.json, package-lock.json, tsconfig.json and README.md
  are this repo's — the version in particular is a placeholder the release
  overwrites from the tag, which is what lets a client fix ship inside one
  engine release (1.0.0-beta.25.2 did).
  """
  pub coreBindings: Changeset! @generate {
    let engine = daggerEngine(ws: self.ws)
    let rendered = tsSdkCodegen.library(
      container: engine.installClient(nodejsBase(nodeVersionLts)),
      introspectionJson: engine.introspectionJson,
    )

    workspaceDir
      .withDirectory(
        corePath,
        git("https://github.com/dagger/typescript-sdk").tag(tsSdkVersion).tree.directory("library/src/core"),
        include: ["connect.ts", "core.ts", "index.ts"],
      )
      .withDirectory(corePath, rendered)
      .changes(workspaceDir)
  }

  """
  The dagger/typescript-sdk release the three hand-written entry points come
  from. Not the bindings — those are rendered above.
  """
  let tsSdkVersion: String! = "v1.3.0"

  """
  Rehearse a core release with no side effects.
  """
  pub releaseCoreDryRun: Void @check {
    releaseCore(
      dryRun: true,
      sourceTag: "HEAD",
      npmToken: null,
      npmRegistryURL: "",
    )
  }

  """
  Publish @dagger.io/core.

  Its version is the **engine** release, not the SDK's, so the tag is taken as
  it comes rather than having the `sdk/typescript/` prefix stripped off it: core
  is the generated bindings for one engine, so the two move together and nothing
  else here does.

  @dagger.io/session is a published dependency, so `npm install` below fetches it
  from the registry. That is deliberate — it is the only thing that proves the
  package boundary holds before the tarball is built.
  """
  pub releaseCore(
    """
    Source git tag to release
    """
    sourceTag: String!,
    """
    NPM authentication token
    """
    npmToken: Secret,
    """
    Execute a dry-run release, with no side effects
    """
    dryRun: Boolean,
    """
    NPM registry URL to publish to.
    """
    npmRegistryURL: String! = "",
  ): Void {
    let versionFlag = if (isSemver(sourceTag)) {
      sourceTag.trimPrefix("v")
    } else {
      "prepatch"
    }
    let prerelease = if (isSemver(sourceTag)) {
      # "" for a stable tag, so the publish below moves `latest`; the channel
      # otherwise, so a beta engine never does.
      prereleaseFromVersion(sourceTag)
    } else {
      # Only a dry run gets here. `npm version prepatch` invents a prerelease,
      # and npm refuses to publish a prerelease of a name it has never seen
      # without a tag — which @dagger.io/core is.
      "dev"
    }

    let build = nodejsBase(nodeVersionLts)
      .withDirectory(".", workspaceDir)
      .withWorkdir(corePath)
      # `ci` rather than `install`: it installs the lockfile exactly and fails
      # when the lockfile and the manifest disagree, so a release cannot
      # quietly resolve a different typescript or session than the one the
      # package was built and tested against.
      .withExec(["npm", "ci", "--no-audit", "--no-fund"])
      .withExec(["npm", "run", "build"])
      # --allow-same-version so a re-run is not fatal: the committed manifest
      # records the last release, so it already holds this version whenever a
      # release is retried.
      .withExec([
        "npm",
        "version",
        versionFlag,
        "--allow-same-version",
        "--no-git-tag-version",
      ])
    # Check that dist/ exists in the build
    build.directory("dist").entries

    let publishArgs = ["npm", "publish", "--access", "public"]
    if (prerelease != "") {
      publishArgs += ["--tag", prerelease]
    }
    if (dryRun == true) {
      publishArgs += ["--dry-run"]
      null
    } else if (npmToken != null) {
      build = build.withMountedSecret(".npmrc", npmrcSecret(npmToken, npmRegistryURL))
      null
    }
    build.withExec(publishArgs).sync
    null
  }

  """
  Point `latest` at a version of @dagger.io/core already on the registry.

  Separate from `releaseCore`, and idempotent, because the two fail
  independently: a publish that lands and a dist-tag move that does not leaves
  `latest` behind, and npm will not accept the same version twice, so a retry
  of the publish cannot repair it. Pointing a tag at a version is repeatable as
  often as it takes.

  Deciding *whether* to move is the caller's: the release module compares the
  versions with semver (release/npm_dist_tag.go) rather than this doing it in
  shell, where a registry error reads as an empty string and a comparator that
  fails to run reads as "do not move".
  """
  pub promoteCoreLatest(
    """
    The published version to point `latest` at, without a leading `v`
    """
    version: String!,
    """
    NPM authentication token
    """
    npmToken: Secret!,
    """
    NPM registry URL to publish to.
    """
    npmRegistryURL: String! = "",
  ): Void {
    nodejsBase(nodeVersionLts)
      .withMountedSecret(".npmrc", npmrcSecret(npmToken, npmRegistryURL))
      .withExec(["npm", "dist-tag", "add", "@dagger.io/core@" + version, "latest"])
      .sync

    null
  }

  """
  An .npmrc authenticating to the registry a release publishes to.
  """
  let npmrcSecret(npmToken: Secret!, npmRegistryURL: String!): Secret! {
    let registry = if (npmRegistryURL != "") {
      npmRegistryURL.trimRight("/") + "/"
    } else {
      "https://registry.npmjs.org/"
    }
    let authHost = registry.trimPrefix("https://").trimPrefix("http://")
    setSecret("npmrc", [
      "//" + authHost + ":_authToken=" + npmToken.plaintext,
      "registry=" + registry,
      "always-auth=true",
    ].join("\n"))
  }

  pub isSemver(version: String!): Boolean! {
    let number = `(0|[1-9][0-9]*)`
    let prereleaseIdentifier =
      `([0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*|0|[1-9][0-9]*)`
    let prerelease =
      `(-${prereleaseIdentifier}(\.${prereleaseIdentifier})*)?`
    let buildIdentifier = `[0-9A-Za-z-]+`
    let build = `(\+${buildIdentifier}(\.${buildIdentifier})*)?`
    let pattern: Regexp! =
      `^v${number}(\.${number}(\.${number}${prerelease}${build})?)?$`
    version.containsMatch(pattern)
  }

  let prereleaseFromVersion(version: String!): String! {
    let prerelease = version.match(
      `^v[0-9]+\.[0-9]+\.[0-9]+-([0-9A-Za-z-]+)`,
    )
    if (prerelease == null) {
      ""
    } else {
      let channel = prerelease.captures[0]
      if (channel == null) { "" } else { channel }
    }
  }

  # Build a nodejs dev environment, with the SDK source code mounted and its dependencies installed
  # FIXME: use baseNodejs() to avoid duplication
  pub nodejsDevContainer(nodeVersion: String! = nodeVersionPrevLts): Container! {
    container
      # ⚠️  Keep this in sync with the engine version defined in package.json
      .from("node:" + nodeVersion + "-alpine")
      .withMountedCache(
        path: "/usr/local/share/.cache/yarn",
        cache: cacheVolume("yarn_cache:" + nodeVersion),
        sharing: CacheSharingMode.LOCKED,
      )
      .withWorkdir("/app")
      .withFile(sourcePath + "/package.json", source.file("package.json"))
      .withFile(sourcePath + "/yarn.lock", source.file("yarn.lock"))
      .withFile(sourcePath + "/eslint.config.js", source.file("eslint.config.js"))
      .withExec(["yarn", "--cwd", sourcePath, "install"])
      .withDirectory(".", workspaceDir)
  }

  # Build a nodejs base image, without any source code mounted
  pub nodejsBase(nodeVersion: String! = nodeVersionPrevLts): Container! {
    container
      .from("node:" + nodeVersion + "-alpine")
      .withMountedCache(
        path: "/usr/local/share/.cache/yarn",
        cache: cacheVolume("yarn_cache:" + nodeVersion),
        sharing: CacheSharingMode.LOCKED,
      )
      .withWorkdir("/app")
  }

  pub bunjsDevContainer: Container! {
    container
      .from("oven/bun:" + bunVersion + "-alpine")
      .withMountedCache("/root/.bun/install/cache", cacheVolume("bun_cache"))
      .withWorkdir("/app")
      .withFile("package.json", source.file("package.json"))
      .withWorkdir(sourcePath)
      .withExec(["bun", "install"])
      .withWorkdir("/app")
      .withDirectory(".", workspaceDir)
  }

  pub binary: File! {
    codegen.binary
  }
}
