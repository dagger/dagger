{{/*
  A dependency's own generated bindings live in internal/dagger/core (see
  _dep.gen.go.tmpl), since methods extending existing core types (e.g. a new
  top-level Query field) can only legally be defined alongside those types'
  real declarations. But a dependency can also contribute brand new types
  (e.g. a "Dep" object), which importing module code references directly as
  dagger.Dep — so those need an alias back in this package too. Types the
  dependency's schema slice merely references (e.g. *Container as a return
  type) are already aliased by dagger.gen.go and are skipped here to avoid
  redeclaring them.
*/}}
{{ if and IsModuleCode (HasNonCoreTypes .Types) }}
// Code generated by dagger. DO NOT EDIT.

package dagger

import (
	"{{.PackageImport}}/internal/dagger/core"
)

{{ range .Types }}
{{ if and (eq .Name "Query") (IsCoreType .Name) }}
{{/*
  Query is always a core type, so its own alias (and the rest of this
  per-type block) is skipped below. But this dependency's schema slice
  only ever keeps the Query fields it contributes (see Schema.Include),
  so any options struct for one of its own fields (e.g. a constructor
  with optional args) still needs aliasing here.
*/}}
{{ range $field := .Fields }}
{{- if HasOptionals $field.Args }}
// {{ $field | FieldOptionsStructName }} contains options for Query.{{ $field.Name | FormatName }}
type {{ $field | FieldOptionsStructName }} = core.{{ $field | FieldOptionsStructName }}
{{ end }}
{{ end }}
{{ end }}
{{ if not (IsCoreType .Name) }}
{{ $name := .Name | FormatName }}

{{ .Description | Comment }}
type {{ $name }} = core.{{ $name }}

{{ if eq .Kind "INTERFACE" }}
{{- $clientName := InterfaceClientName .Name }}
{{- if ne $clientName $name }}
type {{ $clientName }} = core.{{ $clientName }}
{{ end }}
{{- end }}
{{ if eq .Kind "OBJECT" }}
{{- if . | IsSelfChainable }}
type With{{ $name }}Func = core.With{{ $name }}Func
{{ end }}
{{- end }}
{{ if or (eq .Kind "OBJECT") (eq .Kind "INTERFACE") }}
{{ range $field := .Fields }}
{{- if HasOptionals $field.Args }}
// {{ $field | FieldOptionsStructName }} contains options for {{ $name }}.{{ $field.Name | FormatName }}
type {{ $field | FieldOptionsStructName }} = core.{{ $field | FieldOptionsStructName }}
{{ end }}
{{ end }}
{{- end }}

{{ if eq .Kind "ENUM" }}
{{- $enumName := .Name }}
{{- $needsUnscopedEnums := CheckVersionCompatibility "v0.15.0" | not }}
const (
	{{- range $index, $field := .EnumValues | SortEnumFields }}
	{{- $scopedName := $field.Name | FormatEnum $enumName }}
	{{- $unscopedName := $field.Name | FormatEnum "" }}
	{{ $field.Description | Comment }}
	{{ $scopedName }} {{ $enumName }} = core.{{ $scopedName }}
	{{- if and $needsUnscopedEnums (ne $unscopedName $scopedName) }}
	{{ $unscopedName }} {{ $enumName }} = core.{{ $unscopedName }}
	{{- end }}
	{{ end }}
)
{{- end }}
{{ end }}
{{ end }}
{{ end }}
