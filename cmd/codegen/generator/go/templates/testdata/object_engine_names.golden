// A git commit
type GitCommit struct {
	query *querybuilder.Selection

	sha      *string
	shortSha *string
	id       *GitCommitID
}
type WithGitCommitFunc func(r *GitCommit) *GitCommit

// With calls the provided function with current GitCommit.
//
// This is useful for reusability and readability by not breaking the calling chain.
func (r *GitCommit) With(f WithGitCommitFunc) *GitCommit {
	return f(r)
}

func (r *GitCommit) WithGraphQLQuery(q *querybuilder.Selection) *GitCommit {
	return &GitCommit{
		query: q,
	}
}

// The commit SHA.
func (r *GitCommit) SHA(ctx context.Context) (string, error) {
	if r.sha != nil {
		return *r.sha, nil
	}
	q := r.query.Select("sha")

	var response string

	q = q.Bind(&response)
	return response, q.Execute(ctx)
}

// Deprecated: use SHA instead.
func (r *GitCommit) Sha(ctx context.Context) (string, error) {
	return r.SHA(ctx)
}

// The parent commit SHAs.
func (r *GitCommit) ParentSHAs(ctx context.Context) ([]string, error) {
	q := r.query.Select("parentShas")

	var response []string

	q = q.Bind(&response)
	return response, q.Execute(ctx)
}

// Deprecated: use ParentSHAs instead.
func (r *GitCommit) ParentShas(ctx context.Context) ([]string, error) {
	return r.ParentSHAs(ctx)
}

// GitCommitShortSHAOpts contains options for GitCommit.ShortSHA
type GitCommitShortSHAOpts struct {
	// Number of characters.
	Length int
}

// Deprecated: use GitCommitShortSHAOpts instead.
type GitCommitShortShaOpts = GitCommitShortSHAOpts

// The abbreviated SHA.
func (r *GitCommit) ShortSHA(ctx context.Context, opts ...GitCommitShortSHAOpts) (string, error) {
	if r.shortSha != nil {
		return *r.shortSha, nil
	}
	q := r.query.Select("shortSha")
	for i := len(opts) - 1; i >= 0; i-- {
		// `length` optional argument
		if !querybuilder.IsZeroValue(opts[i].Length) {
			q = q.Arg("length", opts[i].Length)
		}
	}

	var response string

	q = q.Bind(&response)
	return response, q.Execute(ctx)
}

// Deprecated: use ShortSHA instead.
func (r *GitCommit) ShortSha(ctx context.Context, opts ...GitCommitShortSHAOpts) (string, error) {
	return r.ShortSHA(ctx, opts...)
}

// Set the push remote.
func (r *GitCommit) WithRemote(pushURL string) *GitCommit {
	q := r.query.Select("withRemote")
	q = q.Arg("pushUrl", pushURL)

	return &GitCommit{
		query: q,
	}
}

// The commit ID.
func (r *GitCommit) ID(ctx context.Context) (GitCommitID, error) {
	if r.id != nil {
		return *r.id, nil
	}
	q := r.query.Select("id")

	var response GitCommitID

	q = q.Bind(&response)
	return response, q.Execute(ctx)
}

// XXX_GraphQLType is an internal function. It returns the native GraphQL type name
func (r *GitCommit) XXX_GraphQLType() string {
	return "GitCommit"
}

// XXX_GraphQLIDType is an internal function. It returns the native GraphQL type name for the ID of this object
func (r *GitCommit) XXX_GraphQLIDType() string {
	return "ID"
}

// XXX_GraphQLID is an internal function. It returns the underlying type ID
func (r *GitCommit) XXX_GraphQLID(ctx context.Context) (string, error) {
	id, err := r.ID(ctx)
	if err != nil {
		return "", err
	}
	return string(id), nil
}

func (r *GitCommit) MarshalJSON() ([]byte, error) {
	id, err := r.ID(marshalCtx)
	if err != nil {
		return nil, err
	}
	return json.Marshal(id)
}
