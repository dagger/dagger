# A Dang twin of ../../go/agent-hirer, reshaped to mirror modules/staff:
# spawn an agent INSIDE a module function, resolve its opening turn there,
# store the handle in module state, and let later module calls address it by
# name — the agent ID itself never crosses back to the caller.
#
# Dang is the load-bearing choice, not a porting exercise. The Dang runtime
# evaluates in-process and serves its function-call client on a local
# listener that is shut down the moment the call returns
# (core/sdk/dang/shared/shared.go WithNestedClientServer), so the spawning
# client genuinely ENDS when hire completes — the same shape as the staff
# module's spawn. A Go runtime container's client connection lingers for the
# rest of the session, which masks the spawner-teardown window
# core/integration/agent_runtime_test.go probes with this fixture.
"""
Hires agents inside module functions, keeping the handles to itself.
"""
type Hirer {
  # Live worker handles, unique by name — the staff module's members map,
  # minus everything not needed to reproduce its shapes. Engine-object
  # handles in Dang state serialize as IDs; a later call deserializes and
  # re-loads them in its own function-call client.
  let workers: Map[Agent!]! = [:]

  """
  The system prompt composed into every hired agent. Public so recordings
  that replay a hired agent's conversation can match its exact text.
  """
  workerPrompt: String! = "You are a worker hired by the hirer module."

  """
  Spawn an agent from the caller's seed, start it on the task, and block
  until the turn that consumed the task ends — then return self with the
  worker stored, so later calls can address it by name.
  """
  hire(
    seed: LLM!,
    name: String!,
    task: String!,
  ): Dagger.Hirer! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): spawns, messages and awaits a real agent runtime —
    # side effects that must actually run, never replay from cache.
    let worker = seed.withSystemPrompt(workerPrompt).spawn(name: name)
    # Response INSIDE the module call: the opening turn provably completes
    # while this function-call client is still alive; the call returning is
    # what ends that client.
    worker.send(task).response
    currentNode.{{... on Dagger.Hirer!}}.withWorker(name, worker)
  }

  """
  Plumbing (mirrors staff.withWorker): store the worker without re-running
  the spawn when the returned ID is replayed.
  """
  withWorker(name: String!, worker: Agent!): Hirer! {
    self.workers = self.workers.with(name, worker)
    self
  }

  """
  Send a message to a hired worker and block for the reply of the turn that
  consumes it — the staff module's ask shape: send, then resume, then
  response, all inside THIS call's own function-call client.

  Send-first matters; the resume-first order this once copied from staff is
  racy: resume wakes or relaunches the loop at once, and a loop woken with an
  empty mailbox steps any suspended turn's pending input before the message
  exists, so it would only steer in a step later. Sent first, the message is
  queued (paused/failed) or starts a stopped worker, and the loop drains the
  mailbox before stepping; resume then just wakes it.
  """
  ask(
    name: String!,
    message: String!,
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): sends and blocks on live runtime state; a replayed
    # answer would masquerade as a fresh round-trip.
    let worker = member(name)
    # send returns an ID!, so Dang runs the enqueue here, before the resume.
    let sent = worker.send(message)
    worker.resume
    sent.response
  }

  """
  The ask, addressed by handle instead of name: send + resume + response on a
  caller-provided Agent. This is how a client that rebuilt a handle from
  the trace hands it INTO a module tool — the path that must work wherever
  node(id:) on the same handle works.
  """
  askAgent(
    agent: Agent!,
    message: String!,
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): same as ask. Send-first for the same reason too.
    let sent = agent.send(message)
    agent.resume
    sent.response
  }

  # Address a worker by name, with a helpful miss (mirrors staff.member).
  let member(name: String!): Agent! {
    let worker = workers[name]
    if (worker == null) {
      raise `no hired worker named "${name}"`
    }
    worker
  }
}
