# A module that implements ModuleEntrypoint, so it can be named by another
# module's [entrypoint] table with kind = "module".
type EntrypointModule {
  pub types(workspace: Workspace!): [TypeDef!]! {
    [
      typeDef
        .withObject("App")
        .withConstructor(function("", typeDef.withObject("App")))
        .withFunction(
          function("Message", typeDef.withKind(TypeDefKind.STRING_KIND)),
        ),
    ]
  }

  pub call(
    workspace: Workspace!,
    receiverType: String!,
    receiverValue: JSON,
    fnName: String!,
    fnArgs: JSON!,
  ): JSON! {
    if (receiverType != "App") {
      raise "unknown receiver type: " + receiverType
    } else if (fnName == "") {
      ("{}" :: JSON!)
    } else if (fnName == "Message") {
      ("\"loaded through the module entrypoint\"" :: JSON!)
    } else {
      raise "unknown function: " + fnName
    }
  }
}
