type Entrypoint implements ModuleEntrypoint {
  pub types(workspace: Workspace!): [TypeDef!]! {
    [
      typeDef
        .withObject("Test")
        .withConstructor(function("", typeDef.withObject("Test")))
        .withFunction(function("Ints", typeDef.withListOf(typeDef.withListOf(typeDef.withKind(TypeDefKind.INTEGER_KIND)))))
        .withFunction(function("Strs", typeDef.withListOf(typeDef.withListOf(typeDef.withKind(TypeDefKind.STRING_KIND))))),
    ]
  }

  pub call(
    workspace: Workspace!,
    receiverType: String!,
    receiverValue: JSON,
    fnName: String!,
    fnArgs: JSON!,
  ): JSON! {
    if (fnName == "") {
      ("{}" :: JSON!)
    } else if (fnName == "Ints") {
      ("[[1,2,3],[2,4,6],[3,6,9]]" :: JSON!)
    } else if (fnName == "Strs") {
      ("[[\"a\",\"b\"],[\"c\",\"d\"]]" :: JSON!)
    } else {
      raise "unknown function: " + fnName
    }
  }
}
