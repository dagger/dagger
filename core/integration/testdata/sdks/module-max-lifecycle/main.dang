"""
Test SDK for module-max scope lifecycle behavior.
"""
type ModuleMaxLifecycle {
  """Starter style used when a module has no source yet."""
  starter: String! = "default"

  let normalizePath(p: String!): String! {
    let trimmed = p.trimPrefix("/").trimPrefix("./").trimSuffix("/")
    if (trimmed == "") { "." } else { trimmed }
  }

  let configDir(foundPath: String!, marker: String!): String! {
    normalizePath(foundPath.trimPrefix("/").trimSuffix(marker))
  }

  let exists(ws: Workspace!, path: String!): Boolean! {
    ws.directory(".", include: [path]).exists(path)
  }

  detectScope(ws: Workspace!): String! {
    let goMod = ws.findUp("go.mod")
    if (goMod == null) {
      ""
    } else {
      configDir(goMod, "go.mod")
    }
  }

  generateScope(
    ws: Workspace!,
    isModule: Boolean!,
    name: String!,
    clients: [ModuleSource!]!,
  ): Workspace! {
    let withModule = if (!isModule) {
      ws
    } else {
      let withConfig = if (exists(ws, "dagger-module.toml")) {
        ws
      } else {
        ws.withDirectory(
          ".",
          moduleManifest(name: name).withLegacyGoRuntime.directory,
        )
      }
      let withGoMod = if (exists(withConfig, "go.mod")) {
        withConfig
      } else {
        withConfig.withNewFile("go.mod", "module " + name + "\n\ngo 1.25\n")
      }
      let withSource = if (exists(withGoMod, "main.go")) {
        withGoMod
      } else if (starter == "empty") {
        withGoMod.withNewFile("main.go", "package main\n\ntype Module struct{}\n")
      } else {
        withGoMod.withNewFile(
          "main.go",
          "package main\n\ntype Module struct{}\n\n" +
          "func (m *Module) Hello() string { return \"hello\" }\n",
        )
      }
      withSource.withNewFile(
        "internal/dagger/sdk-module-max.gen.txt",
        "generated by module-max-lifecycle for " + name + "\n",
      )
    }

    let clean = if (exists(withModule, "internal/dagger/clients")) {
      withModule.withoutDirectory("internal/dagger/clients")
    } else {
      withModule
    }

    clients.reduce(clean) { generated, target =>
      let targetName = target.moduleOriginalName
      generated.withNewFile(
        "internal/dagger/clients/" + targetName + ".gen.go",
        "// Code generated by module-max-lifecycle. DO NOT EDIT.\n" +
        "package clients\n\n" +
        "var _ = \"" + target.asString + "\"\n",
      )
    }
  }
}
