type Reporter {
  """
  Report the paths added by applying a changeset that also rewrites a file the
  workspace already has, byte for byte.
  """
  pub rewrittenBaseline(ws: Workspace!): [String!]! {
    let before = Dagger.directory.withNewFile("generated.txt", "generated")
    let after = before
      .withTimestamps(1234567890)
      .withNewFile("added.txt", "added")
    ws.withChanges(after.changes(before)).changes(ws).addedPaths
  }

  """
  Report the paths changed by applying a changeset that edits a file the
  workspace already has.
  """
  pub modifiedBaseline(ws: Workspace!): [String!]! {
    let before = Dagger.directory.withNewFile("generated.txt", "generated")
    let after = before
      .withTimestamps(1234567890)
      .withNewFile("generated.txt", "regenerated")
    let changes = ws.withChanges(after.changes(before)).changes(ws)
    changes.modifiedPaths + changes.addedPaths
  }
}
