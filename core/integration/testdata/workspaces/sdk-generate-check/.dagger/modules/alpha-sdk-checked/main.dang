# alpha-sdk plus an explicit `generate` check, so a test can install this
# module under the alpha-sdk name and exercise the dedup. The SDK behaviour is
# identical to alpha-sdk.

"""
Test SDK for the check derived from an engine-injected generator.
"""
type AlphaSdk {
  findClientRoot(ws: Workspace!): String {
    "."
  }

  generateScope(
    ws: Workspace!,
    isModule: Boolean!,
    name: String!,
    clients: [ModuleSource!]!,
  ): Workspace! {
    let generated = if (isModule) {
      ws
        .withNewFile(
          "dagger-module.toml",
          "name = " + JSON.encode(name) + "\n" +
            "engineVersion = \"latest\"\n\n" +
            "[runtime]\n" +
            "  source = \"dang\"\n",
        )
        .withNewFile(
          "main.dang",
          "type Generated {\n  pub hello: String! {\n    \"hello\"\n  }\n}\n",
        )
        .withNewFile("generated/alpha.txt", "generated by alpha-sdk\n")
    } else {
      ws
    }

    clients.reduce(generated) { current, target =>
      current.withNewFile(
        "generated/" + target.moduleOriginalName + ".client.txt",
        "client for " + target.moduleOriginalName + "\n",
      )
    }
  }

  """
  An explicit check that occupies the name the derived check would use.
  """
  pub generate: Void @check {
    null
  }
}
