"""
Tools with required object-typed args, for the address-lifting integration
tests (liftableObjectArg in core/llm_object_tools.go).
"""
type Runner {
  """
  Run a command in a sandbox container and return its stdout.

  The required Container! arg is address-liftable, so this function must
  still be exposed as a tool, with sandbox rendered as an address string:
  the model can pass an image ref (or a Container ID from a prior tool
  result) and the engine lifts it via Query.address at dispatch.
  """
  exec(cmd: [String!]!, sandbox: Container!): String! {
    sandbox.withExec(cmd).stdout
  }

  """
  Run a command in every sandbox container and return their stdouts.

  A list of an address-liftable type lifts element-wise: each element may be
  an image ref or a Container ID from a prior tool result.
  """
  execAll(cmd: [String!]!, sandboxes: [Container!]!): [String!]! {
    sandboxes.map { sandbox => sandbox.withExec(cmd).stdout }
  }

  """
  List a directory's entries.

  Directory is address-liftable too, so this function is a tool.
  """
  lsDir(dir: Directory!): [String!]! {
    dir.entries
  }

  """
  Report the commit a git ref points to.

  GitRef is address-liftable: a git URL with a #ref resolves to that ref.
  """
  commitOf(ref: GitRef!): String! {
    "commit: " + ref.commitSHA
  }

  """
  Run a conversation over this module's own tools.

  Its tool calls then run under this module rather than the CLI, as a worker
  agent spawned by a module does: the delegated case for address lifting.
  """
  delegate(model: String!, prompt: String!): String! {
    llm(model: model).withTools(currentNode).withPrompt(prompt).loop.transcript
  }

  """
  Like delegate, with the conversation bound to a checkout of source, as an
  agent working in a checked-out repository is.
  """
  delegateIn(model: String!, prompt: String!, source: GitRef!): String! {
    llm(model: model)
      .withWorkspace(source.asWorkspace)
      .withTools(currentNode)
      .withPrompt(prompt)
      .loop
      .transcript
  }

  """
  Use a token.

  Secret is blocklisted — a model-typed env:// or file:// address would mint
  a secret it was never handed — so this function must NOT be a tool.
  """
  useToken(token: Secret!): String! {
    if (token.plaintext == "") { "empty" } else { "set" }
  }
}
