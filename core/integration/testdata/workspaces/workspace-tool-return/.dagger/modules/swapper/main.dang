"""Tools that return a Workspace, for @agent integration tests."""
type Swapper {
  """
  Return the current workspace with a marker file added.

  The auto-injected Workspace! is the agent's current workspace; returning a
  derived one exercises the tool -> workspace rebinding (a tool that returns a
  Workspace replaces the LLM's current workspace, mirroring Changeset overlay).
  """
  swap(ws: Workspace!): Workspace! {
    ws.withNewFile("SWAPPED.txt", "swapped by tool")
  }

  addFirst(ws: Workspace!): Changeset! {
    let root = ws.directory("/")
    root.withNewFile("FIRST.txt", "first parallel change").changes(root)
  }

  addSecond(ws: Workspace!): Changeset! {
    let root = ws.directory("/")
    root.withNewFile("SECOND.txt", "second parallel change").changes(root)
  }

  """
  Rewrite both lines of shared.txt one way.

  Paired with clashSecond to produce two parallel changesets that rewrite the
  same lines, i.e. a batch that cannot merge cleanly.
  """
  clashFirst(ws: Workspace!): Changeset! {
    let root = ws.directory("/")
    root.withNewFile("shared.txt", "line1: RED\nline2: RED\n").changes(root)
  }

  """Rewrite both lines of shared.txt the other way. See clashFirst."""
  clashSecond(ws: Workspace!): Changeset! {
    let root = ws.directory("/")
    root.withNewFile("shared.txt", "line1: BLUE\nline2: BLUE\n").changes(root)
  }
}
