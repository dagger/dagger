"""
The external Dang SDK's fixture for the golden tests: every SDK fixture has
the same functions, so their goldens line up. Dang has no process to exit,
so there is no failExitCode, and print writes only to stdout. The check
functions are `dagger check`'s cases; see sdkCheckCases.
"""
type ViztestDang {
  """
  Logs to stdout, and succeeds.
  """
  logSuccess: String! @cache(policy: FunctionCachePolicy.PER_SESSION) {
    print("dang function stdout")
    "dang function result"
  }

  """
  Logs to stdout, then raises an error of its own.
  """
  failNative: Void @cache(policy: FunctionCachePolicy.PER_SESSION) {
    print("dang function stdout")
    raise "dang function failed natively"
  }

  """
  Runs a command that fails, and lets its error propagate.
  """
  failExec: String! @cache(policy: FunctionCachePolicy.PER_SESSION) {
    failingExec.stdout
  }

  """
  Runs a command that fails, and wraps its error.
  """
  failExecWrapped: String! @cache(policy: FunctionCachePolicy.PER_SESSION) {
    failingExec.stdout rescue {
      err: GraphQLError! => raise "dang function ran a failing command: " + err.message
    }
  }

  """
  Logs a line, then reads a file that doesn't exist, and lets the error
  propagate.
  """
  failApi: String! @cache(policy: FunctionCachePolicy.PER_SESSION) {
    print("dang function stdout")
    directory.file("doesnt-exist.txt").contents
  }

  """
  Calls a function of a dependency whose command fails.
  """
  callFailingDep: String! @cache(policy: FunctionCachePolicy.PER_SESSION) {
    sdkDep.failExec
  }

  """
  Logs a line, then calls a function of a dependency whose command fails.
  """
  callFailingDepLogged: String! @cache(policy: FunctionCachePolicy.PER_SESSION) {
    print("dang function stdout")
    sdkDep.failExec
  }

  """
  A check that logs to stdout, then raises an error of its own.
  """
  checkFailNative: Void @check @cache(policy: FunctionCachePolicy.PER_SESSION) {
    print("dang function stdout")
    raise "dang check failed natively"
  }

  """
  A check that raises a Dagger Error, which it returns as an SDK returns one.
  """
  checkReturnedError: Void @check @cache(policy: FunctionCachePolicy.PER_SESSION) {
    raise error(message: "dang check returned an error")
  }

  """
  A check that runs a command that fails, and lets its error propagate.
  """
  checkFailExec: Void @check @cache(policy: FunctionCachePolicy.PER_SESSION) {
    failingExec.sync
    null
  }

  """
  A check that logs, and passes. Cached, as a check is by default.
  """
  checkPass: Void @check {
    print("dang check passed")
    null
  }

  """
  A collection of test cases, each with a check: the "fail" case's fails.
  """
  cases: CheckCases! {
    CheckCases(names: ["fail", "pass"])
  }

  """
  A collection of test cases with no cases.
  """
  noCases: CheckCases! {
    CheckCases(names: [])
  }

  """
  A generator that writes a file in the directory it runs from.
  """
  generateFile: Changeset! @generate {
    directory.withNewFile("generated.txt", "generated by viztest-dang\n").changes(directory)
  }

  """
  A generator with nothing to change.
  """
  generateNothing: Changeset! @generate {
    directory.changes(directory)
  }

  let failingExec: Container! {
    container
      .from("alpine")
      .withExec(["sh", "-c", "echo exec stdout; sleep 0.1; echo exec stderr >&2; exit 1"])
  }
}

"""
Test cases, each with a check of its own.
"""
type CheckCases @collection {
  names: [String!]! @keys
  item(name: String!): CheckCase! @get { CheckCase(name: name) }
}

"""
A test case.
"""
type CheckCase {
  let name: String!

  """
  Logs the case's name, and passes unless the case is "fail".
  """
  check: Void @check @cache(policy: FunctionCachePolicy.PER_SESSION) {
    print("dang case " + name)
    if (name == "fail") {
      raise "dang case fail failed"
    } else {
      null
    }
  }
}
