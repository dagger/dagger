"""
Run agent conversations through the official Codex CLI.

`dagger agent` asks Dagger Core to supply the credential matching the explicit
Codex harness kind. ChatGPT subscription OAuth uses app-server's external-auth
protocol, while an OpenAI API key uses its login RPC. Credentials never enter
the module's container recipe, and refreshed OAuth tokens remain in Dagger's
client-side LLM configuration.
"""
type Codex {
  """Use the official Codex CLI as the conversation harness."""
  agent(base: LLM!): LLM! @agent {
    base.withHarness(
      harness: container
        .from("node:22-bookworm-slim")
        .withExec(["npm", "install", "--global", "@openai/codex@latest"])
        .withWorkdir("/workspace"),
      kind: LLMHarnessKind.CODEX,
    )
  }
}
