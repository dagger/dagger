# contributor: GitHub operations for a Dagger coding agent.
#
# Two capabilities today:
#
# - `reviewComments` reads pull request review threads via the GitHub API,
#   so an agent can be pointed at review feedback — a PR number, a PR URL,
#   or a single-comment #discussion_r link — and read the full thread with
#   its file/line/diff context.
#
# - `prComment` leaves feedback on a pull request — on the conversation, or
#   anchored to a file/line of the diff. Comments are agent-authored by
#   definition, so the tool enforces a ":robot:" body prefix that tells
#   readers a machine wrote the comment, not the human operator.
#
# - `contribute` dispatches a sub-agent into a DIFFERENT repository and
#   turns its work into a pull request there. `modules/delegate` spawns a
#   sub-agent in YOUR workspace; this spawns one in SOMEBODY ELSE'S: it
#   fetches a foreign git repo as a Workspace (GitRef.asWorkspace), binds it
#   to a fresh `llm` with the `editor` tools composed on (their `Workspace!`
#   args auto-fill from the bound workspace, so Read/Write/Edit/Grep/... all
#   operate on the foreign checkout), lets it work the task to completion,
#   and publishes the resulting delta as a PR. The motivating case: while
#   working on dagger you notice a bug in an upstream dependency (say
#   github.com/dagger/otel-go) — hand the fix off instead of
#   context-switching, and all that comes back is the PR URL and a report.
#
# Configuration lives in dagger.toml settings, not per-call arguments:
# `githubToken` authenticates every GitHub operation, reaching the container
# only as a secret env var (GH_TOKEN) — never baked into an image layer,
# never echoed. `remote` names the GitHub repository bare PR numbers resolve
# against; it's a property of the project rather than of any one task (a
# permanent fork would simply configure a different value).

# Tail-truncate command output to keep tool results context-friendly (same
# helper shape as modules/tui-qa and modules/engine-lab).
let tailLines = 200
# Patches read top-down, so they get head-truncated instead.
let patchLines = 400

# Last `lines` lines of s, with a truncation marker when shortened.
let tail(s: String!, lines: Int! = tailLines): String! {
  let all = s.split("\n")
  if (all.length <= lines) {
    s
  } else {
    let marker = "… (" + toString(all.length - lines) + " earlier lines truncated) …"
    marker + "\n" + all.takeLast(lines).join("\n")
  }
}

# First `lines` lines of s, with a truncation marker when shortened.
let head(s: String!, lines: Int! = patchLines): String! {
  let all = s.split("\n")
  if (all.length <= lines) {
    s
  } else {
    let marker = "… (" + toString(all.length - lines) + " later lines truncated) …"
    all.takeFirst(lines).join("\n") + "\n" + marker
  }
}

"""
GitHub operations: read pull request review comments, and dispatch a
sub-agent into another git repository to submit its work as a pull request.
"""
type Contributor {
  # Private so the secret is never exposed as a field/tool argument.
  let token: Secret = null
  # The GitHub repository PR numbers resolve against. Private: configured in
  # settings, not steered per-call.
  let remote: String! = ""

  new(
    """
    A GitHub token used to authenticate API calls, push branches, and open
    pull requests.

    Wire it up in dagger.toml settings rather than passing it around:

        [env.dev.modules.contributor.settings]
        githubToken = "env://GITHUB_TOKEN"

    Without it, only `dryRun: true` contributions work.
    """
    githubToken: Secret = null,
    """
    The GitHub repository this project's pull requests live in, as
    "owner/name" (a github.com URL works too). Like the token, this belongs
    in dagger.toml settings — it's a property of the project, not of any one
    task, so it shouldn't vary between contributors or throwaway forks (a
    permanent fork would simply configure a different value):

        [env.dev.modules.contributor.settings]
        remote = "dagger/dagger"
    """
    remote: String! = "",
  ) {
    self.token = githubToken
    self.remote = remote
    self
  }

  """
  Compose the contributor tools onto a base LLM.
  """
  agent(base: LLM!): LLM! @agent {
    base
      .withTools(currentNode)
      .withSystemPrompt(systemPrompt)
  }

  """
  Read the review comments on a GitHub pull request, grouped into threads
  with their file, line, and diff context.

  Accepts a bare PR number (resolved against the configured remote
  repository) or a full PR URL. A link to a single comment — the
  `#discussion_r<id>` URLs GitHub hands out — narrows the output to just
  that comment's thread.
  """
  reviewComments(
    """
    The pull request to read: a number like "13831", a URL like
    "https://github.com/dagger/dagger/pull/13831", or a single-comment link
    like "https://github.com/dagger/dagger/pull/13831#discussion_r3732814956".
    """
    pr: String!,
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): review threads are live conversations — new replies must
    # show up on the next read, not be replayed from the session cache.
    let tok = token
    if (tok == null) {
      raise noTokenError
    }

    let repo = ""
    let number = ""
    let discussion = ""
    let ref = pr.trimPrefix("#")
    if (ref.containsMatch(`^\d+$`)) {
      repo = remoteSlug
      number = ref
    } else {
      let m = ref.match(`github\.com/([^/]+)/([^/]+)/pull/(\d+)(?:/files)?(?:#(?:discussion_)?r(\d+))?`)
      if (m == null) {
        raise `not a pull request reference: "${pr}" — pass a PR number or a github.com PR URL`
      }
      # Indexing is statically nullable; groups always exist on a match, and
      # the unmatched optional fragment group surfaces as "".
      repo = (m.captures[0] ?? "") + "/" + (m.captures[1] ?? "")
      number = m.captures[2] ?? ""
      discussion = m.captures[3] ?? ""
    }

    # Fetch every review comment on the PR, then let jq group them into
    # threads (replies carry in_reply_to_id pointing at the thread root) and
    # render them — narrowed to one thread when DISCUSSION_ID is set.
    let script = """
      set -eu
      # Secret commands (e.g. `gh auth token`) commonly emit a trailing
      # newline; HTTP headers reject it.
      GH_TOKEN="$(printf '%s' "$GH_TOKEN" | tr -d '[:space:]')"
      export GH_TOKEN
      if [ -n "$DISCUSSION_ID" ]; then
        printf '## Review thread discussion_r%s on %s#%s\n\n' "$DISCUSSION_ID" "$OWNER_REPO" "$PR_NUMBER"
      else
        printf '## Review comments on %s#%s\n\n' "$OWNER_REPO" "$PR_NUMBER"
      fi
      comments="$(gh api --paginate "repos/$OWNER_REPO/pulls/$PR_NUMBER/comments?per_page=100")"
      printf '%s' "$comments" | jq -rs -f /tmp/render.jq
    """

    let ran = toolbox
      .withNewFile("/tmp/render.jq", renderJq)
      .withEnvVariable("OWNER_REPO", repo)
      .withEnvVariable("PR_NUMBER", number)
      .withEnvVariable("DISCUSSION_ID", discussion)
      # live read: never serve replies from the exec cache
      .withEnvVariable("CONTRIBUTOR_NONCE", Random.string)
      .withSecretVariable("GH_TOKEN", tok)
      .withExec(["sh", "-c", script], expect: ReturnType.ANY).{{exitCode, stdout, combinedOutput}}

    if (ran.exitCode != 0) {
      raise `reading review comments for ${repo}#${number} failed (exit ${toString(ran.exitCode)}):` + "\n\n" + tail(ran.combinedOutput)
    }

    # Threads read top-down, so head-truncate like a patch.
    head(ran.stdout)
  }

  """
  Make an authenticated, read-only GitHub API request (`gh api`) and return
  the response, optionally filtered through a jq expression.

  Covers everything the REST API exposes: code search
  ("search/code?q=repo:owner/name+needle"), PR/issue metadata, releases,
  file listings, and so on. Requests are GET-only — this tool cannot
  mutate anything on GitHub.

  Raw GitHub payloads are huge; pass `jq` to select just the fields you
  need (e.g. ".items[].path").
  """
  ghApi(
    """
    The API path to GET, e.g. "repos/dagger/dagger/releases/latest" or
    "search/code?q=repo:badlogic/pi-mono+toolSnippets". A leading slash is
    fine. Placeholders {owner}/{repo} resolve against the configured remote.
    """
    path: String!,
    """
    jq expression applied to the response (gh's built-in --jq), e.g.
    ".items[] | {path, repository: .repository.full_name}". Empty returns
    the raw JSON.
    """
    jq: String! = "",
    """
    Follow pagination (--paginate) and concatenate all pages. Combine with
    a jq filter to keep the output manageable.
    """
    paginate: Boolean! = false,
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): the API is a live read — issues get comments, releases
    # get published; don't replay stale responses from the session cache.
    let tok = token
    if (tok == null) {
      raise noTokenError
    }

    let script = """
      set -eu
      # Secret commands (e.g. `gh auth token`) commonly emit a trailing
      # newline; HTTP headers reject it.
      GH_TOKEN="$(printf '%s' "$GH_TOKEN" | tr -d '[:space:]')"
      export GH_TOKEN
      set -- api --method GET "${API_PATH#/}"
      if [ -n "$PAGINATE" ]; then set -- "$@" --paginate; fi
      if [ -n "$JQ_EXPR" ]; then set -- "$@" --jq "$JQ_EXPR"; fi
      gh "$@"
    """

    let ran = toolbox
      .withEnvVariable("API_PATH", path)
      .withEnvVariable("JQ_EXPR", jq)
      .withEnvVariable("PAGINATE", if (paginate) { "1" } else { "" })
      # live read: never serve API responses from the exec cache
      .withEnvVariable("CONTRIBUTOR_NONCE", Random.string)
      .withSecretVariable("GH_TOKEN", tok)
      .withExec(["sh", "-c", script], expect: ReturnType.ANY).{{exitCode, stdout, combinedOutput}}

    if (ran.exitCode != 0) {
      raise `GET ${path} failed (exit ${toString(ran.exitCode)}):` + "\n\n" + tail(ran.combinedOutput)
    }

    # JSON reads top-down, so head-truncate like a patch.
    head(ran.stdout)
  }

  """
  Leave feedback on a GitHub pull request as a comment — on the PR
  conversation, or anchored to a file (and optionally a line) of the diff.

  Comments posted this way are agent-authored, so `body` MUST start with
  ":robot:" — the marker that tells readers a machine wrote the comment,
  not the human operator. Calls without the prefix are rejected.
  """
  prComment(
    """
    The pull request to comment on: a number like "13831" (resolved against
    the configured remote) or a URL like
    "https://github.com/dagger/dagger/pull/13831".
    """
    pr: String!,
    """
    The comment body (Markdown), starting with ":robot:". Keep it kind,
    brief, and to-the-point.
    """
    body: String!,
    """
    File path within the repository to anchor the comment to, as a review
    comment on that file. Empty posts on the PR conversation instead.
    """
    path: String! = "",
    """
    Line number to anchor the comment to, in the file's post-PR version.
    The line must appear in the PR's diff. 0 anchors to the file as a
    whole. Requires `path`.
    """
    line: Int! = 0,
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): posting a comment is a side effect, not something to
    # replay from the session cache.
    let tok = token
    if (tok == null) {
      raise noTokenError
    }
    if (!body.trimSpace.hasPrefix(":robot:")) {
      raise robotPrefixError
    }
    if (line != 0 and path == "") {
      raise "a line anchor needs a file: pass `path` along with `line`"
    }

    # Same PR-reference forms as reviewComments, minus the discussion links
    # (replying into a thread is reviewComments territory; this tool opens
    # new ones).
    let repo = ""
    let number = ""
    let ref = pr.trimPrefix("#")
    if (ref.containsMatch(`^\d+$`)) {
      repo = remoteSlug
      number = ref
    } else {
      let m = ref.match(`github\.com/([^/]+)/([^/]+)/pull/(\d+)`)
      if (m == null) {
        raise `not a pull request reference: "${pr}" — pass a PR number or a github.com PR URL`
      }
      repo = (m.captures[0] ?? "") + "/" + (m.captures[1] ?? "")
      number = m.captures[2] ?? ""
    }

    # File-anchored comments go through the review-comments API (which needs
    # the PR's current head commit); plain feedback is an issue comment on
    # the PR conversation. The body travels as a file, never spliced into
    # shell source.
    let script = """
      set -eu
      # Secret commands (e.g. `gh auth token`) commonly emit a trailing
      # newline; HTTP headers reject it.
      GH_TOKEN="$(printf '%s' "$GH_TOKEN" | tr -d '[:space:]')"
      export GH_TOKEN
      if [ -n "$FILE_PATH" ]; then
        head_sha="$(gh api "repos/$OWNER_REPO/pulls/$PR_NUMBER" --jq .head.sha)"
        set -- api --method POST "repos/$OWNER_REPO/pulls/$PR_NUMBER/comments" \
          -F "body=@/tmp/body.md" \
          -f "commit_id=$head_sha" \
          -f "path=$FILE_PATH"
        if [ "$LINE" -gt 0 ]; then
          set -- "$@" -F "line=$LINE" -f side=RIGHT
        else
          set -- "$@" -f subject_type=file
        fi
        gh "$@" --jq .html_url
      else
        gh api --method POST "repos/$OWNER_REPO/issues/$PR_NUMBER/comments" \
          -F "body=@/tmp/body.md" --jq .html_url
      fi
    """

    let ran = toolbox
      .withNewFile("/tmp/body.md", body)
      .withEnvVariable("OWNER_REPO", repo)
      .withEnvVariable("PR_NUMBER", number)
      .withEnvVariable("FILE_PATH", path)
      .withEnvVariable("LINE", toString(line))
      # posting must actually happen every time, not be served from the
      # exec cache
      .withEnvVariable("CONTRIBUTOR_NONCE", Random.string)
      .withSecretVariable("GH_TOKEN", tok)
      .withExec(["sh", "-c", script], expect: ReturnType.ANY).{{exitCode, stdout, combinedOutput}}

    if (ran.exitCode != 0) {
      raise `commenting on ${repo}#${number} failed (exit ${toString(ran.exitCode)}):` + "\n\n" + tail(ran.combinedOutput)
    }

    `Posted comment: ${ran.stdout.trimSpace}`
  }

  """
  Make a change in ANOTHER git repository and submit it as a pull request.

  Fetches `repo`, spawns a fresh sub-agent with full editing tools bound to
  that checkout, has it complete `task`, then commits the resulting diff onto
  `branch`, pushes it, and opens a PR. Returns the PR URL plus the sub-agent's
  final report.

  The sub-agent starts with NONE of your context and only its final report
  comes back, so phrase `task` self-contained: what to change, where to look,
  and what "done" means.

  Use `dryRun: true` first when you want to inspect the patch before anything
  is pushed.
  """
  contribute(
    """
    Git URL of the repository to contribute to, e.g.
    "https://github.com/dagger/otel-go".
    """
    repo: String!,
    """
    The work for the sub-agent to do in that repository. Must be
    self-contained: the sub-agent has none of your conversation context.
    """
    task: String!,
    """
    Name of the feature branch to create and push, e.g. "fix-span-leak".
    """
    branch: String!,
    """
    Branch to base the work on. Empty means the repository's default branch.
    """
    baseBranch: String! = "",
    """
    Pull request title. Also used as the commit subject.
    """
    title: String!,
    """
    Pull request body. The sub-agent's final report is appended under an
    "## Agent report" section either way.
    """
    body: String! = "",
    """
    Do everything except pushing and opening the PR: return the sub-agent's
    report plus a summary and the patch it would have submitted.
    """
    dryRun: Boolean! = false,
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): contributing is a side effect (a real branch, a real PR),
    # not something to replay from the session cache.

    # Fail fast, before burning a whole sub-agent conversation on work we
    # couldn't possibly publish. (`publish` re-checks, which is what actually
    # narrows the secret to non-null.)
    if (!dryRun and token == null) {
      raise noTokenError
    }

    let repository = git(repo)
    let base = if (baseBranch == "") {
      repository.head
    } else {
      repository.branch(baseBranch)
    }
    let source = base.asWorkspace

    # A fresh conversation bound to the FOREIGN workspace: the editor tools'
    # `Workspace!` args are auto-filled from it, so every read and edit lands
    # in that repo's checkout rather than ours.
    let worker = editor
      .agent(base: llm.withWorkspace(source))
      .withSystemPrompt(subAgentPrompt)
      .withPrompt(task)
      .loop

    let report = worker.lastReply

    # Only the sub-agent's own delta against the checkout it was handed.
    let changes = worker
      .workspace
      .directory("/")
      .changes(from: source.directory("/"))

    if (changes.isEmpty) {
      return [
        "## Agent report",
        "",
        report,
        "",
        `No changes were made to ${repo}, so no pull request was opened.`,
      ].join("\n")
    }

    let summary = renderStats(changes)
    let patchFile = changes.asPatch

    if (dryRun) {
      let baseLabel = if (baseBranch == "") {
        "(repository default)"
      } else {
        baseBranch
      }
      return [
        "## Agent report",
        "",
        report,
        "",
        `## Would contribute to ${repo} (dry run — nothing pushed)`,
        "",
        `branch: ${branch}`,
        `base: ${baseLabel}`,
        `title: ${title}`,
        "",
        summary,
        "",
        "## Patch",
        "",
        head(patchFile.contents),
      ].join("\n")
    }

    let prBody = if (body == "") {
      ["## Agent report", "", report].join("\n")
    } else {
      [body, "", "## Agent report", "", report].join("\n")
    }

    let url = publish(
      repo: repo,
      branch: branch,
      baseBranch: baseBranch,
      title: title,
      prBody: prBody,
      patch: patchFile,
      token: token,
    )

    [
      `Opened pull request: ${url}`,
      "",
      summary,
      "",
      "## Agent report",
      "",
      report,
    ].join("\n")
  }

  # ---- helpers ------------------------------------------------------------

  # Shared toolbox for GitHub operations: git, gh, and jq.
  let toolbox: Container! {
    container
      .from("alpine:3.20")
      .withExec(["apk", "add", "--no-cache", "git", "github-cli", "jq"])
  }

  # The configured remote normalized to "owner/name" (full https/ssh
  # github.com URLs work too). Raises when no remote is configured.
  let remoteSlug: String! {
    if (remote == "") {
      raise noRemoteError
    }
    let m = remote.match(`github\.com[:/]([^/]+)/([^/]+?)(?:\.git)?/?$`)
    if (m == null) {
      remote
    } else {
      (m.captures[0] ?? "") + "/" + (m.captures[1] ?? "")
    }
  }

  # jq program rendering a PR's review comments (a JSON array of pages, via
  # `jq -s` over `gh api --paginate`) as markdown threads. DISCUSSION_ID
  # narrows the output to the thread containing that comment.
  let renderJq: String! = """
    # A comment anchors at the LAST line of its diff hunk, so keep the tail.
    def trimhunk: split("\n")
      | if length > 24
        then ["… (" + ((length - 24) | tostring) + " earlier hunk lines truncated) …"] + .[-24:]
        else .
        end
      | join("\n");
    (env.DISCUSSION_ID // "") as $did
    | add
    | map(. + {thread: (.in_reply_to_id // .id)})
    | if $did == "" then .
      else
        ( map(select(.id == ($did | tonumber)))
          | if length == 0
            then error("comment r" + $did + " is not a review comment on this pull request")
            else .[0].thread
            end
        ) as $root
        | map(select(.thread == $root))
      end
    | if length == 0 then "No review comments."
      else
        group_by(.thread)
        | map(
            .[0] as $top
            | "### "
              + ($top.path // "(general)")
              + (if $top.line != null then ":" + ($top.line | tostring)
                 elif $top.original_line != null then ":" + ($top.original_line | tostring) + " (outdated)"
                 else ""
                 end)
              + "\n"
              + (if ($top.diff_hunk // "") != ""
                 then "\n```diff\n" + ($top.diff_hunk | trimhunk) + "\n```\n"
                 else ""
                 end)
              + (map("\n"
                     + (.user.login // "ghost")
                     + " (" + .created_at + ") discussion_r" + (.id | tostring) + ":\n\n"
                     + .body + "\n")
                 | join(""))
          )
        | join("\n---\n\n")
      end
  """

  # Clone the repo authenticated, branch off, apply the patch, commit, push,
  # and open the PR. Returns the `gh pr create` output (the PR URL).
  #
  # Everything variable is passed as an env var and quoted in the script, so
  # no caller-supplied string is ever spliced into shell source. The token is
  # a secret env var read only by a git credential helper.
  let publish(
    repo: String!,
    branch: String!,
    baseBranch: String!,
    title: String!,
    prBody: String!,
    patch: File!,
    token: Secret,
  ): String! {
    if (token == null) {
      raise noTokenError
    }

    let commitMessage = title + "\n\n" + prBody

    # Everything up to `gh pr create` writes to stderr, so stdout carries only
    # the PR URL. `gh` infers the target repo from the clone's origin remote.
    let script = """
      set -eu
      # Secret commands (e.g. `gh auth token`) commonly emit a trailing
      # newline; git's credential helper tolerates it but HTTP headers do not
      # (gh: 'invalid header field value for "Authorization"').
      GH_TOKEN="$(printf '%s' "$GH_TOKEN" | tr -d '[:space:]')"
      export GH_TOKEN
      {
        git config --global credential.helper '!f() { echo username=x-access-token; echo "password=$GH_TOKEN"; }; f'
        git config --global user.name "Dagger Contributor Agent"
        git config --global user.email "noreply@dagger.io"
        if [ -n "$BASE_BRANCH" ]; then
          git clone --depth 1 --branch "$BASE_BRANCH" "$REPO_URL" /work
        else
          git clone --depth 1 "$REPO_URL" /work
        fi
        cd /work
        git checkout -b "$BRANCH"
        git apply --verbose /tmp/contribution.patch
        git add -A
        git commit -F /tmp/commit.msg
        # Force: retries of the same contribution re-push the same branch.
        git push -fu origin "$BRANCH"
      } >&2
      cd /work
      if [ -n "$BASE_BRANCH" ]; then
        gh pr create --title "$PR_TITLE" --body-file /tmp/pr.md --base "$BASE_BRANCH" --head "$BRANCH"
      else
        gh pr create --title "$PR_TITLE" --body-file /tmp/pr.md --head "$BRANCH"
      fi
    """

    let ctr = toolbox
      .withFile("/tmp/contribution.patch", patch)
      .withNewFile("/tmp/commit.msg", commitMessage)
      .withNewFile("/tmp/pr.md", prBody)
      .withEnvVariable("REPO_URL", repo)
      .withEnvVariable("BRANCH", branch)
      .withEnvVariable("BASE_BRANCH", baseBranch)
      .withEnvVariable("PR_TITLE", title)
      # push + PR creation must actually happen every time, not be served from
      # the exec cache
      .withEnvVariable("CONTRIBUTOR_NONCE", Random.string)
      .withSecretVariable("GH_TOKEN", token)

    let ran = ctr
      .withExec(["sh", "-c", script], expect: ReturnType.ANY).{{exitCode, stdout, combinedOutput}}

    if (ran.exitCode != 0) {
      raise `publishing the contribution failed (exit ${toString(ran.exitCode)}):` + "\n\n" + tail(ran.combinedOutput)
    }

    ran.stdout.trimSpace
  }

  let renderStats(changes: Changeset!): String! {
    let stats = changes.diffStats.{{path, kind, addedLines, removedLines}}
    let added = 0
    let removed = 0
    let lines = stats.map { s =>
      added += s.addedLines
      removed += s.removedLines
      `${renderKind(s.kind)} ${s.path} (+${toString(s.addedLines)}/-${toString(s.removedLines)})`
    }
    let header = `## Changes (${toString(stats.length)} files, +${toString(added)}/-${toString(removed)})`
    ([header, ""] + lines).join("\n")
  }

  let renderKind(kind: DiffStatKind!): String! {
    case (kind) {
      DiffStatKind.ADDED => "A"
      DiffStatKind.MODIFIED => "M"
      DiffStatKind.REMOVED => "D"
      DiffStatKind.RENAMED => "R"
      else => "?"
    }
  }

  let noTokenError: String! = """
    No GitHub token is configured, so GitHub API operations are unavailable.
    Wire one up in dagger.toml:

        [env.dev.modules.contributor.settings]
        githubToken = "env://GITHUB_TOKEN"

    (Contributions can still be previewed without one via dryRun: true.)
  """

  let robotPrefixError: String! = """
    Comments posted by this tool are agent-authored and must be marked as
    such: start the body with ":robot:" so readers can tell the comment was
    written by a machine, not the human operator.
  """

  let noRemoteError: String! = """
    No GitHub remote is configured, so a bare PR number cannot be resolved.
    Set the repository in dagger.toml (or pass a full PR URL instead):

        [env.dev.modules.contributor.settings]
        remote = "dagger/dagger"
  """

  # Instructions for the PARENT agent holding these tools.
  let systemPrompt: String! = """
    You have GitHub tools: `reviewComments` for reading pull request review
    feedback, `ghApi` for read-only GitHub API queries, and `contribute` for
    submitting work to other repositories.

    `ghApi` GETs any GitHub REST API path with authentication — code search
    ("search/code?q=repo:owner/name+needle"), PR/issue metadata, releases,
    CI check runs. Reach for it instead of fetching github.com web pages,
    which render as mostly navigation noise. Always pass a `jq` filter to
    keep the response small; raw payloads rarely fit in context.

    `reviewComments` reads the review comment threads on a pull request —
    each with its file, line, and diff context. Pass a PR number (resolved
    against the project's configured GitHub remote) or a full PR URL; the
    single-comment links people paste in conversation (ending in
    #discussion_r<id>) narrow the output to just that comment's thread. When
    asked to look at or address review feedback, read the thread first and
    act on what it actually says.

    `prComment` leaves feedback on a pull request: pass the PR and a body,
    plus optionally a file path (and line within the diff) to anchor it as
    a review comment. Comments posted this way are agent-authored, so the
    body must start with ":robot:" — the tool rejects it otherwise. Keep
    feedback kind, brief, and to-the-point.

    The `contribute` tool sends a fresh sub-agent into ANOTHER git repository
    to do a task there, and submits the result as a pull request to that
    repository.

    Use it when the fix belongs somewhere else — e.g. an upstream bug in a
    dependency like github.com/dagger/otel-go — instead of working around it
    locally or context-switching to a separate checkout. Your own workspace is
    untouched; the change lands as a PR on the target repo, and all that comes
    back to you is the PR URL and the sub-agent's short report.

    The sub-agent starts with NONE of your context — it can only see the
    repository it is dropped into, and only its final report returns to you.
    So phrase `task` self-contained: what's wrong, how you know, what the fix
    should look like, and how to tell it worked. Give a real PR `title` and,
    when the reasoning matters to a reviewer, a `body`.

    Pass `dryRun: true` to run the whole loop but stop before pushing: you get
    the patch and a diff summary to review. Do that first when you're unsure
    the task is well-specified, or when you don't intend to open a PR yet.
  """

  # Instructions for the SUB-agent working inside the foreign repository.
  let subAgentPrompt: String! = """
    You are a sub-agent handling one self-contained task inside a repository
    that is NOT the one your caller works in. Work autonomously to completion
    using the available tools — do not ask follow-up questions.

    Your change is destined for an upstream PULL REQUEST against this
    repository, so:
    - Follow the conventions of the repository you are in — read neighbouring
      code, tests, and any contributing docs before writing anything. Your
      caller's house style is irrelevant here.
    - Keep the change minimal and reviewable: fix the thing you were asked to
      fix, and nothing else. No drive-by refactors, no reformatting, no new
      documentation files unless the task calls for them.
    - Update or add tests when the repository has them and the change warrants
      it.

    Make your edits directly in your workspace: the changes you make to the
    filesystem are collected automatically and turned into the pull request,
    so do NOT commit, push, or otherwise try to deliver them yourself.

    When done, reply with a single concise report: what you changed and why,
    anything you deliberately left alone, and any errors or surprises. Your
    reply is the only thing that returns to the caller, and it is published as
    part of the pull request description — write it for a reviewer.
  """
}
