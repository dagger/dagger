let maxResponseLength = 30000
let workspacePath = "/workspace"

"""
A Dagger-native sandboxed coding agent.
"""
type Editor {
  """
  Returns a basic coding agent
  """
  agent(base: LLM!): LLM! @agent {
    base
      .withTools(currentNode)
      .withSystemPrompt("""
        You are an autonomous, sandboxed coding agent running in Dagger.

        Guidelines:
        - Use Find and Grep for file discovery (ls, find, rg equivalents)
        - Use Read to examine files before editing
        - Use Edit for precise changes (oldText must match exactly)
        - Use Write only for new files or complete rewrites
        - Be concise in your responses
        - Show file paths clearly when working with files
        - Follow existing conventions in files that you edit
        - NEVER proactively create documentation files (*.md) or README files
        - Always prefer editing an existing file to creating a new one
        - Do what has been asked; nothing more, nothing less
        - Use multiple tool calls concurrently whenever possible
      """)
      .withSystemPrompt(reminderPrompt(base.workspace))
  }

  """
  Install a Dagger module and continue with its tools available immediately.

  The module is added to the workspace config and the conversation is
  recomposed against the updated workspace, so the new tools show up in THIS
  session — no restart, no lost context. If the module fails to load, the call
  fails and the session carries on unchanged.

  NOTE: this replaces the whole agent composition, so system prompts added
  outside it (e.g. a one-off prompt supplied at session start) are dropped;
  every module's own prompts and tools are rebuilt from the updated workspace.
  """
  install(
    llm: LLM!,
    """
    Module reference to install, e.g. a local path like ./modules/review or a
    remote address like github.com/dagger/dagger/modules/foo.
    """
    ref: String!,
  ): LLM! {
    let updated = llm.workspace.withModule(ref)
    updated.agents.compose(base: llm.withWorkspace(updated).withoutSystemPrompts)
  }

  """
  Reload the agent's own modules from the current workspace source.

  Use this after editing a module that provides your tools (self-repair): the
  conversation is recomposed against the workspace as it stands now — pending
  edits included — so the edited tool takes effect immediately, with the
  conversation intact. If the edited module fails to load, the call fails and
  the session carries on with the previous toolset.

  NOTE: as with install, system prompts added outside the agent composition are
  dropped.
  """
  reload(llm: LLM!): LLM! {
    let current = llm.workspace.reloaded
    current.agents.compose(base: llm.withWorkspace(current).withoutSystemPrompts)
  }

  let todos: [TODO!]! = []

  """
  Keep track of your TODO list

  WHEN TO USE THIS TOOL:
  	- When a task requires 3 or more distinct steps or actions
  	- To break down a complex task into smaller, manageable parts
  	- When the user directly gave a sequence of tasks to perform (numbered
  		or comma-separated)
  	- When the user gave you more tasks in the middle of a conversation
  	- When you want to see the full TODO list

  SKIP THIS TOOL WHEN:
  	- The task is trivial
  	- The task is purely conversational or informational

  HOW TO USE:
  	- Call this function with the TODOs to record in each state (pending,
  		in progress, completed)
  	- TODOs are additive; you can call it with incremental updates for
  		individual TODOs
  	- The full TODO list will be printed in response
  	- Every pending TODO must be eventually completed before your task is
  		completed
  	- To print the current TODO list, call this function with no arguments
  """
  todoWrite(
    pending: [String!]! = [],
    inProgress: [String!]! = [],
    completed: [String!]! = [],
  ): Editor! {
    # Build list of all descriptions being updated
    let updatingDescriptions = pending + inProgress + completed

    let existingPending: [String!]! = []
    let existingInProgress: [String!]! = []
    let existingDone: [String!]! = []
    todos.each { todo =>
      # Only keep existing TODOs that aren't being updated
      if (updatingDescriptions.contains(todo.description)) {
        continue
      }
      case (todo.status) {
        TODOStatus.DONE => {
          existingDone += [todo.description]
        }

        TODOStatus.IN_PROGRESS => {
          existingInProgress += [todo.description]
        }

        TODOStatus.PENDING => {
          existingPending += [todo.description]
        }
      }
    }

    self.todos = []
    self.todos += (existingDone + completed).map { desc =>
      TODO(TODOStatus.DONE, desc)
    }
    self.todos += (existingInProgress + inProgress).map { desc =>
      TODO(TODOStatus.IN_PROGRESS, desc)
    }
    self.todos += (existingPending + pending).map { desc =>
      TODO(TODOStatus.PENDING, desc)
    }

    self.todos.each { todo =>
      let prefix = case (todo.status) {
        TODOStatus.DONE => "■ \x1b[32m\x1b[9m"
        TODOStatus.IN_PROGRESS => "□ \x1b[33m"
        TODOStatus.PENDING => "□ \x1b[37m"
      }
      print(prefix + todo.description + "\x1b[0m")
    }

    self
  }

  """
  Read the contents of a file. Output is truncated to 2000 lines by default. Each line is prefixed with its line number. Use offset/limit for large files. When you need the full file, continue with offset until complete.
  """
  read(
    source: Workspace!,
    """
    Relative path within the workspace
    """
    filePath: String!,
    """
    Line offset to start reading from
    """
    offset: Int! = 0,
    """
    Limit the number of lines read
    """
    limit: Int! = 2000,
  ): String! {
    let fileContents = source
      .file(normalize(filePath))
      .contents(
        offsetLines: offset,
        limitLines: limit,
      )

    if (fileContents == "") {
      "WARNING: File contents are empty."
    } else {
      fileContents
        .split("\n", 0)
        .map { line, i =>
          `${toString(offset + i + 1).padLeft(6)}→${line}`
        }
        .join("\n")
    }
  }

  """
  Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.
  """
  write(
    source: Workspace!,
    """
    Relative path within the workspace
    """
    filePath: String!,
    """
    Complete file content to write
    """
    contents: String!,
    """
    Force-write the file - only used to resolve merge conflicts
    """
    force: Boolean! = false,
  ): Workspace! {
    source.withNewFile(normalize(filePath), contents)
  }

  """
  Edit a file by replacing exact text. The oldText must match exactly (including whitespace). Use this for precise, surgical edits. For larger edits, use the Write tool to overwrite files.
  """
  edit(
    source: Workspace!,
    """
    Relative path within the workspace
    """
    filePath: String!,
    """
    Unique search string to replace within the file, or non-unique if replaceAll is true
    """
    oldText: String!,
    """
    New text content
    """
    newText: String!,
    """
    Replace all occurrences
    """
    replaceAll: Boolean! = false,
    """
    Force-write the file - only used to resolve merge conflicts
    """
    force: Boolean! = false,
  ): Changeset! {
    let normalizedPath = normalize(filePath)
    let base = source.directory(".", include: [normalizedPath])
    base
      .withFile(
        normalizedPath,
        source
          .file(normalizedPath)
          .withReplaced(oldText, newText, all: replaceAll),
      )
      .changes(base)
  }

  """
  Run checks (tests, lints, etc.), optionally filtering by glob patterns (e.g. `test:*`, `go:*`).

  The results are the rendered trace of this call: a row per check, with the
  failing ones' output. A failing check is not an error.
  """
  check(workspace: Workspace!, include: [String!]! = []): Void {
    let matched = workspace.checks(include)
    if (matched.list.{{name}}.isEmpty) {
      print("WARNING: no checks matched. Available checks:")
      print(listChecks(workspace))
      null
    } else {
      # `run` errors as soon as a check fails. Swallow it: what the model
      # reads is this call's trace, where each failure is a ✘ row carrying the
      # failing exec's output and exit code.
      {
        matched.run.list.{{name}}
        null
      } rescue {
        e: Error => null
      }
    }
  }

  """
  List available checks.
  """
  listChecks(workspace: Workspace!, include: [String!]! = []): String! {
    workspace.checks(include).list.{{name, description}}.map { x =>
      if (x.description != "") {
        x.name + ": " + x.description
      } else {
        x.name
      }
    }.join("\n")
  }

  """
  Run generators and apply their changes, optionally filtering by glob patterns (e.g. `go:*`).
  """
  generate(workspace: Workspace!, include: [String!]! = []): Changeset {
    let matched = workspace.generators(include)
    if (matched.list.{{name}}.isEmpty) {
      print("WARNING: no generators matched. Available generators:")
      listGenerators(workspace)
      null
    } else {
      matched.run.changes
    }
  }

  """
  List available generators.
  """
  listGenerators(workspace: Workspace!, include: [String!]! = []): String! {
    workspace.generators(include).list.{{name, description}}.map { x =>
      if (x.description != "") {
        x.name + ": " + x.description
      } else {
        x.name
      }
    }.join("\n")
  }

  """
  Remove a file or directory.
  """
  rm(
    source: Workspace!,
    """
    Relative path within the workspace
    """
    path: String!,
    """
    Force-remove the file - only used to resolve merge conflicts
    """
    force: Boolean! = false,
  ): Workspace! {
    source.withoutFile(normalize(path))
  }

  """
  Rename or move a file or directory. Parent directories are created automatically.
  """
  mv(
    source: Workspace!,
    """
    Relative path within the workspace of the file or directory to move
    """
    oldPath: String!,
    """
    Destination path within the workspace
    """
    newPath: String!,
    """
    Force-move the file - only used to resolve merge conflicts
    """
    force: Boolean! = false,
  ): Changeset {
    let normalizedPath = normalize(oldPath)
    let base = source
      .directory(".", include: [normalizedPath])
    let changes = if (base.exists(oldPath, expectedType: ExistsType.REGULAR_TYPE)) {
      base
        .withFile(newPath, source.file(oldPath))
        .withoutFile(oldPath)
        .changes(base)
    } else if (base.exists(oldPath, expectedType: ExistsType.DIRECTORY_TYPE)) {
      base
        .withDirectory(newPath, source.directory(oldPath))
        .withoutDirectory(oldPath)
        .changes(base)
    }
    changes
  }

  """
  Commit changes. Folds uncommitted changes — pending edits, writes, moves,
  and removals included — into a commit on the workspace's current branch, or
  only the given paths for a partial commit (the rest stay pending). Prints
  the short hash and a per-file summary of exactly what was committed.

  Commits are staged in the workspace, like every other change: the user's
  local checkout is untouched until they save the workspace.

  WHEN TO USE:
  	- After completing a coherent unit of work (a fix, one step of a task)
  	- Before starting a risky or sweeping change, so it can be reverted
  	- With paths, to split unrelated changes into separate commits

  Write messages like good git commits: a concise imperative subject line,
  optionally followed by a blank line and an explanatory body.
  """
  commit(
    source: Workspace!,
    """
    The headline of the commit (50 chars or less).
    """
    subject: String!,
    """
    The body for the commit.
    """
    body: String! = "",
    """
    Relative paths (files or directories) to commit, like `git commit -- <paths>`.
    Empty commits all uncommitted changes.
    """
    paths: [String!]! = [],
    """
    RFC3339 timestamp for the commit date. Defaults to the current time. Only
    set this to backdate deliberately.
    """
    date: String = null,
  ): Workspace! {
    # Strings have no .length in Dang — lists do, so count characters by
    # splitting on the empty separator.
    if (subject.split("").length > 50) {
      raise "commit subject too long (must be 50 characters or less)"
    }

    let normalizedPaths = paths.map { normalize(_) }
    let stats = source.git.uncommitted.diffStats.{{path, kind, addedLines, removedLines}}
    let scoped = if (normalizedPaths.isEmpty) {
      stats
    } else {
      stats.filter { s =>
        normalizedPaths.any { p => Path(p).contains(Path(s.path)) }
      }
    }

    let message = subject
    if (body != "") {
      message += "\n\n" + body
    }

    if (scoped.isEmpty) {
      if (stats.isEmpty) {
        print("WARNING: nothing to commit - no uncommitted changes.")
      } else {
        print("WARNING: nothing to commit under the given paths. Uncommitted changes:")
        stats.each { s =>
          print(`${renderKind(s.kind)} ${s.path} (+${s.addedLines}/-${s.removedLines})`)
        }
      }
      source
    } else {
      let commitDate = date ?? currentTimestamp
      let committed = source.withCommit(message, paths: normalizedPaths, date: commitDate)
      let shortHash = committed.git.head.commit.split("", 8).takeFirst(7).join("")
      print(`[${shortHash}] ${message.split("\n", 2)[0]}`)
      # Report what the commit actually recorded — the staged commit's own
      # changeset — not the pre-commit pending view. The two can disagree:
      # e.g. a stale-looking path that the repository resolves as unchanged
      # shows up in `uncommitted` but never lands in the commit.
      let staged = committed.git.stagedCommits.{{
        changes.{{ diffStats.{{ path, kind, addedLines, removedLines }} }},
      }}
      staged.takeLast(1).each { c =>
        let rows = c.changes.diffStats
        rows.each { s =>
          print(`${renderKind(s.kind)} ${s.path} (+${toString(s.addedLines)}/-${toString(s.removedLines)})`)
        }
      }
      committed
    }
  }

  # Nullable: diffStat records selected through the staged commit's nullable
  # `changes` field inherit its nullability; non-null values still match.
  let renderKind(kind: DiffStatKind): String! {
    case (kind) {
      DiffStatKind.ADDED => "A"
      DiffStatKind.MODIFIED => "M"
      DiffStatKind.REMOVED => "D"
      DiffStatKind.RENAMED => "R"
      else => "?"
    }
  }

  """
  Find paths by glob pattern. Use '**' to match across directories.
  """
  find(
    source: Workspace!,
    """
    Relative glob pattern to find within the workspace
    """
    pattern: String!,
  ): String! {
    let matches = source.glob(pattern)
    if (matches.length == 0) {
      "No files found."
    } else {
      matches.join("\n")
    }
  }

  """
  Search file contents for a regex pattern. Respects .gitignore. Use literalText for exact matches. Use glob to filter by file type.
  """
  grep(
    source: Workspace!,
    """
    Regular expression pattern to grep for
    """
    regex: String!,
    """
    Treat pattern as literal text instead of a regular expression
    """
    literalText: Boolean! = false,
    """
    Relative paths within the workspace to limit the search
    """
    paths: [String!]! = [],
    """
    Relative path globs within the workspace to limit the search
    """
    globs: [String!]! = [],
    """
    Allow the pattern to span multiple lines
    """
    multiline: Boolean! = false,
    """
    Show the matching content
    """
    content: Boolean! = true,
    """
    Case-insensitive search
    """
    insensitive: Boolean! = false,
    """
    Limit the number of matches
    """
    limit: Int! = 1000,
  ): String! {
    let normalizedPaths = paths.map { normalize(_) }

    let matches = source.search(
      pattern: regex,
      literal: literalText,
      paths: normalizedPaths,
      globs: globs,
      multiline: multiline,
      dotall: multiline,
      filesOnly: !content,
      insensitive: insensitive,
      limit: limit,
      skipIgnored: true,
    ).{{filePath, lineNumber, matchedLines}}

    matches.each { result =>
      let msg = `${result.filePath}:${result.lineNumber}`
      if (content) {
        msg += result.matchedLines
      }
      print(msg)
    }

    if (matches.length == 0) {
      return "No matches found."
    }

    print(`${matches.length} matches found`)

    # files-only mode: just the paths, like `rg -l`
    if (!content) {
      return matches.map { _.filePath }.join("\n")
    }

    # group by file, header + indented `line:content`
    let out = ""
    let lastPath = ""
    matches.each { m =>
      if (m.filePath != lastPath) {
        out += (if (lastPath == "") { "" } else { "\n" }) + m.filePath + "\n"
        lastPath = m.filePath
      }
      out += "  " + toString(m.lineNumber) + ":" + m.matchedLines
    }
    let fileCount = matches.{{filePath}}.uniq.length
    out + "\n" + toString(matches.length) + " matches in " + toString(fileCount) + " files"
  }

  # """
  # Run a bash command in a container.
  #
  # NOTES:
  # - Use `apk` to install packages.
  # - Your initial working directory is always /work. Prepend `cd foo &&` to your command to change it.
  # """
  # bash(ws: Workspace!, cmd: String!): Doug! {
  #   # wire the workspace into the sandbox
  #   let before = sandbox
  #     .withDirectory("/work", ws.directory("/"))
  #     .withWorkdir("/work")
