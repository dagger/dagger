  #   # run the command - note: we still keep the result of a nonzero exit
  #   let after = before.withExec(["bash", "-c", cmd], expect: ReturnType.ANY)
  #   if (after.exitCode != 0) {
  #     print("exit code: " + toString(after.exitCode))
  #   }
  #
  #   # see if the command changed anything
  #   let diff = after
  #     .directory("/work")
  #     .changes(before.directory("/work"))
