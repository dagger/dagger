# github: authenticated GitHub operations for a Dagger coding agent.
#
# Capabilities:
#
# - `reviewComments` reads pull request review threads via the GitHub API,
#   so an agent can be pointed at review feedback — a PR number, a PR URL,
#   or a single-comment #discussion_r link — and read the full thread with
#   its file/line/diff context.
#
# - `prComment` leaves feedback on a pull request — on the conversation, or
#   anchored to a file/line of the diff. Comments are agent-authored by
#   definition, so the tool enforces a ":robot:" body prefix that tells
#   readers a machine wrote the comment, not the human operator.
#
# Configuration lives in dagger.toml settings, not per-call arguments:
# `githubToken` authenticates every GitHub operation, reaching the container
# only as a secret env var (GH_TOKEN) — never baked into an image layer,
# never echoed. `remote` names the GitHub repository bare PR numbers resolve
# against; it's a property of the project rather than of any one task (a
# permanent fork would simply configure a different value).

# Tail-truncate command output to keep tool results context-friendly (same
# helper shape as modules/tui-qa and modules/engine-lab).
let tailLines = 200
# Patches read top-down, so they get head-truncated instead.
let patchLines = 400

# Last `lines` lines of s, with a truncation marker when shortened.
let tail(s: String!, lines: Int! = tailLines): String! {
  let all = s.split("\n")
  if (all.length <= lines) {
    s
  } else {
    let marker = "… (" + toString(all.length - lines) + " earlier lines truncated) …"
    marker + "\n" + all.takeLast(lines).join("\n")
  }
}

# First `lines` lines of s, with a truncation marker when shortened.
let head(s: String!, lines: Int! = patchLines): String! {
  let all = s.split("\n")
  if (all.length <= lines) {
    s
  } else {
    let marker = "… (" + toString(all.length - lines) + " later lines truncated) …"
    all.takeFirst(lines).join("\n") + "\n" + marker
  }
}

"""
GitHub API operations for pull request review and repository metadata.
"""
type Github {
  # Private so the secret is never exposed as a field/tool argument.
  let token: Secret = null
  # The GitHub repository PR numbers resolve against. Private: configured in
  # settings, not steered per-call.
  let remote: String! = ""

  new(
    """
    A GitHub token used to authenticate API calls and review comments.

    Wire it up in dagger.toml settings rather than passing it around:

        [env.dev.modules.github.settings]
        githubToken = "env://GITHUB_TOKEN"
    """
    githubToken: Secret = null,
    """
    The GitHub repository this project's pull requests live in, as
    "owner/name" (a github.com URL works too). Like the token, this belongs
    in dagger.toml settings — it's a property of the project, not of any one
    task, so it shouldn't vary between callers or throwaway forks (a
    permanent fork would simply configure a different value):

        [env.dev.modules.github.settings]
        remote = "dagger/dagger"
    """
    remote: String! = "",
  ) {
    self.token = githubToken
    self.remote = remote
    self
  }

  """
  Compose the GitHub tools onto a base LLM.
  """
  agent(base: LLM!): LLM! @agent {
    base
      .withTools(currentNode)
      .withSystemPrompt(systemPrompt)
  }

  """
  Read the review comments on a GitHub pull request, grouped into threads
  with their file, line, and diff context.

  Accepts a bare PR number (resolved against the configured remote
  repository) or a full PR URL. A link to a single comment — the
  `#discussion_r<id>` URLs GitHub hands out — narrows the output to just
  that comment's thread.
  """
  reviewComments(
    """
    The pull request to read: a number like "13831", a URL like
    "https://github.com/dagger/dagger/pull/13831", or a single-comment link
    like "https://github.com/dagger/dagger/pull/13831#discussion_r3732814956".
    """
    pr: String!,
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): review threads are live conversations — new replies must
    # show up on the next read, not be replayed from the session cache.
    let tok = token
    if (tok == null) {
      raise noTokenError
    }

    let repo = ""
    let number = ""
    let discussion = ""
    let ref = pr.trimPrefix("#")
    if (ref.containsMatch(`^\d+$`)) {
      repo = remoteSlug
      number = ref
    } else {
      let m = ref.match(`github\.com/([^/]+)/([^/]+)/pull/(\d+)(?:/files)?(?:#(?:discussion_)?r(\d+))?`)
      if (m == null) {
        raise `not a pull request reference: "${pr}" — pass a PR number or a github.com PR URL`
      }
      # Indexing is statically nullable; groups always exist on a match, and
      # the unmatched optional fragment group surfaces as "".
      repo = (m.captures[0] ?? "") + "/" + (m.captures[1] ?? "")
      number = m.captures[2] ?? ""
      discussion = m.captures[3] ?? ""
    }

    # Fetch every review comment on the PR, then let jq group them into
    # threads (replies carry in_reply_to_id pointing at the thread root) and
    # render them — narrowed to one thread when DISCUSSION_ID is set.
    let script = """
      set -eu
      # Secret commands (e.g. `gh auth token`) commonly emit a trailing
      # newline; HTTP headers reject it.
      GH_TOKEN="$(printf '%s' "$GH_TOKEN" | tr -d '[:space:]')"
      export GH_TOKEN
      if [ -n "$DISCUSSION_ID" ]; then
        printf '## Review thread discussion_r%s on %s#%s\n\n' "$DISCUSSION_ID" "$OWNER_REPO" "$PR_NUMBER"
      else
        printf '## Review comments on %s#%s\n\n' "$OWNER_REPO" "$PR_NUMBER"
      fi
      comments="$(gh api --paginate "repos/$OWNER_REPO/pulls/$PR_NUMBER/comments?per_page=100")"
      printf '%s' "$comments" | jq -rs -f /tmp/render.jq
    """

    let ran = toolbox
      .withNewFile("/tmp/render.jq", renderJq)
      .withEnvVariable("OWNER_REPO", repo)
      .withEnvVariable("PR_NUMBER", number)
      .withEnvVariable("DISCUSSION_ID", discussion)
      # live read: never serve replies from the exec cache
      .withEnvVariable("GITHUB_NONCE", Random.string)
      .withSecretVariable("GH_TOKEN", tok)
      .withExec(["sh", "-c", script], expect: ReturnType.ANY).{{exitCode, stdout, combinedOutput}}

    if (ran.exitCode != 0) {
      raise `reading review comments for ${repo}#${number} failed (exit ${toString(ran.exitCode)}):` + "\n\n" + tail(ran.combinedOutput)
    }

    # Threads read top-down, so head-truncate like a patch.
    head(ran.stdout)
  }

  """
  Make an authenticated, read-only GitHub API request (`gh api`) and return
  the response, optionally filtered through a jq expression.

  Covers everything the REST API exposes: code search
  ("search/code?q=repo:owner/name+needle"), PR/issue metadata, releases,
  file listings, and so on. Requests are GET-only — this tool cannot
  mutate anything on GitHub.

  Raw GitHub payloads are huge; pass `jq` to select just the fields you
  need (e.g. ".items[].path").
  """
  ghApi(
    """
    The API path to GET, e.g. "repos/dagger/dagger/releases/latest" or
    "search/code?q=repo:badlogic/pi-mono+toolSnippets". A leading slash is
    fine. Placeholders {owner}/{repo} resolve against the configured remote.
    """
    path: String!,
    """
    jq expression applied to the response (gh's built-in --jq), e.g.
    ".items[] | {path, repository: .repository.full_name}". Empty returns
    the raw JSON.
    """
    jq: String! = "",
    """
    Follow pagination (--paginate) and concatenate all pages. Combine with
    a jq filter to keep the output manageable.
    """
    paginate: Boolean! = false,
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): the API is a live read — issues get comments, releases
    # get published; don't replay stale responses from the session cache.
    let tok = token
    if (tok == null) {
      raise noTokenError
    }

    let script = """
      set -eu
      # Secret commands (e.g. `gh auth token`) commonly emit a trailing
      # newline; HTTP headers reject it.
      GH_TOKEN="$(printf '%s' "$GH_TOKEN" | tr -d '[:space:]')"
      export GH_TOKEN
      set -- api --method GET "${API_PATH#/}"
      if [ -n "$PAGINATE" ]; then set -- "$@" --paginate; fi
      if [ -n "$JQ_EXPR" ]; then set -- "$@" --jq "$JQ_EXPR"; fi
      gh "$@"
    """

    let ran = toolbox
      .withEnvVariable("API_PATH", path)
      .withEnvVariable("JQ_EXPR", jq)
      .withEnvVariable("PAGINATE", if (paginate) { "1" } else { "" })
      # live read: never serve API responses from the exec cache
      .withEnvVariable("GITHUB_NONCE", Random.string)
      .withSecretVariable("GH_TOKEN", tok)
      .withExec(["sh", "-c", script], expect: ReturnType.ANY).{{exitCode, stdout, combinedOutput}}

    if (ran.exitCode != 0) {
      raise `GET ${path} failed (exit ${toString(ran.exitCode)}):` + "\n\n" + tail(ran.combinedOutput)
    }

    # JSON reads top-down, so head-truncate like a patch.
    head(ran.stdout)
  }

  """
  Leave feedback on a GitHub pull request as a comment — on the PR
  conversation, or anchored to a file (and optionally a line) of the diff.

  Comments posted this way are agent-authored, so `body` MUST start with
  ":robot:" — the marker that tells readers a machine wrote the comment,
  not the human operator. Calls without the prefix are rejected.
  """
  prComment(
    """
    The pull request to comment on: a number like "13831" (resolved against
    the configured remote) or a URL like
    "https://github.com/dagger/dagger/pull/13831".
    """
    pr: String!,
    """
    The comment body (Markdown), starting with ":robot:". Keep it kind,
    brief, and to-the-point.
    """
    body: String!,
    """
    File path within the repository to anchor the comment to, as a review
    comment on that file. Empty posts on the PR conversation instead.
    """
    path: String! = "",
    """
    Line number to anchor the comment to, in the file's post-PR version.
    The line must appear in the PR's diff. 0 anchors to the file as a
    whole. Requires `path`.
    """
    line: Int! = 0,
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    # @cache(Never): posting a comment is a side effect, not something to
    # replay from the session cache.
    let tok = token
    if (tok == null) {
      raise noTokenError
    }
    if (!body.trimSpace.hasPrefix(":robot:")) {
      raise robotPrefixError
    }
    if (line != 0 and path == "") {
      raise "a line anchor needs a file: pass `path` along with `line`"
    }

    # Same PR-reference forms as reviewComments, minus the discussion links
    # (replying into a thread is reviewComments territory; this tool opens
    # new ones).
    let repo = ""
    let number = ""
    let ref = pr.trimPrefix("#")
    if (ref.containsMatch(`^\d+$`)) {
      repo = remoteSlug
      number = ref
    } else {
      let m = ref.match(`github\.com/([^/]+)/([^/]+)/pull/(\d+)`)
      if (m == null) {
        raise `not a pull request reference: "${pr}" — pass a PR number or a github.com PR URL`
      }
      repo = (m.captures[0] ?? "") + "/" + (m.captures[1] ?? "")
      number = m.captures[2] ?? ""
    }

    # File-anchored comments go through the review-comments API (which needs
    # the PR's current head commit); plain feedback is an issue comment on
    # the PR conversation. The body travels as a file, never spliced into
    # shell source.
    let script = """
      set -eu
      # Secret commands (e.g. `gh auth token`) commonly emit a trailing
      # newline; HTTP headers reject it.
      GH_TOKEN="$(printf '%s' "$GH_TOKEN" | tr -d '[:space:]')"
      export GH_TOKEN
      if [ -n "$FILE_PATH" ]; then
        head_sha="$(gh api "repos/$OWNER_REPO/pulls/$PR_NUMBER" --jq .head.sha)"
        set -- api --method POST "repos/$OWNER_REPO/pulls/$PR_NUMBER/comments" \
          -F "body=@/tmp/body.md" \
          -f "commit_id=$head_sha" \
          -f "path=$FILE_PATH"
        if [ "$LINE" -gt 0 ]; then
          set -- "$@" -F "line=$LINE" -f side=RIGHT
        else
          set -- "$@" -f subject_type=file
        fi
        gh "$@" --jq .html_url
      else
        gh api --method POST "repos/$OWNER_REPO/issues/$PR_NUMBER/comments" \
          -F "body=@/tmp/body.md" --jq .html_url
      fi
    """

    let ran = toolbox
      .withNewFile("/tmp/body.md", body)
      .withEnvVariable("OWNER_REPO", repo)
      .withEnvVariable("PR_NUMBER", number)
      .withEnvVariable("FILE_PATH", path)
      .withEnvVariable("LINE", toString(line))
      # posting must actually happen every time, not be served from the
      # exec cache
      .withEnvVariable("GITHUB_NONCE", Random.string)
      .withSecretVariable("GH_TOKEN", tok)
      .withExec(["sh", "-c", script], expect: ReturnType.ANY).{{exitCode, stdout, combinedOutput}}

    if (ran.exitCode != 0) {
      raise `commenting on ${repo}#${number} failed (exit ${toString(ran.exitCode)}):` + "\n\n" + tail(ran.combinedOutput)
    }

    `Posted comment: ${ran.stdout.trimSpace}`
  }

  # ---- helpers ------------------------------------------------------------

  # Shared toolbox for GitHub operations: gh and jq.
  let toolbox: Container! {
    container
      .from("alpine:3.20")
      .withExec(["apk", "add", "--no-cache", "github-cli", "jq"])
  }

  # The configured remote normalized to "owner/name" (full https/ssh
  # github.com URLs work too). Raises when no remote is configured.
  let remoteSlug: String! {
    if (remote == "") {
      raise noRemoteError
    }
    let m = remote.match(`github\.com[:/]([^/]+)/([^/]+?)(?:\.git)?/?$`)
    if (m == null) {
      remote
    } else {
      (m.captures[0] ?? "") + "/" + (m.captures[1] ?? "")
    }
  }

  # jq program rendering a PR's review comments (a JSON array of pages, via
  # `jq -s` over `gh api --paginate`) as markdown threads. DISCUSSION_ID
  # narrows the output to the thread containing that comment.
  let renderJq: String! = """
    # A comment anchors at the LAST line of its diff hunk, so keep the tail.
    def trimhunk: split("\n")
      | if length > 24
        then ["… (" + ((length - 24) | tostring) + " earlier hunk lines truncated) …"] + .[-24:]
        else .
        end
      | join("\n");
    (env.DISCUSSION_ID // "") as $did
    | add
    | map(. + {thread: (.in_reply_to_id // .id)})
    | if $did == "" then .
      else
        ( map(select(.id == ($did | tonumber)))
          | if length == 0
            then error("comment r" + $did + " is not a review comment on this pull request")
            else .[0].thread
            end
        ) as $root
        | map(select(.thread == $root))
      end
    | if length == 0 then "No review comments."
      else
        group_by(.thread)
        | map(
            .[0] as $top
            | "### "
              + ($top.path // "(general)")
              + (if $top.line != null then ":" + ($top.line | tostring)
                 elif $top.original_line != null then ":" + ($top.original_line | tostring) + " (outdated)"
                 else ""
                 end)
              + "\n"
              + (if ($top.diff_hunk // "") != ""
                 then "\n```diff\n" + ($top.diff_hunk | trimhunk) + "\n```\n"
                 else ""
                 end)
              + (map("\n"
                     + (.user.login // "ghost")
                     + " (" + .created_at + ") discussion_r" + (.id | tostring) + ":\n\n"
                     + .body + "\n")
                 | join(""))
          )
        | join("\n---\n\n")
      end
  """

  let noTokenError: String! = """
    No GitHub token is configured, so GitHub API operations are unavailable.
    Wire one up in dagger.toml:

        [env.dev.modules.github.settings]
        githubToken = "env://GITHUB_TOKEN"
  """

  let robotPrefixError: String! = """
    Comments posted by this tool are agent-authored and must be marked as
    such: start the body with ":robot:" so readers can tell the comment was
    written by a machine, not the human operator.
  """

  let noRemoteError: String! = """
    No GitHub remote is configured, so a bare PR number cannot be resolved.
    Set the repository in dagger.toml (or pass a full PR URL instead):

        [env.dev.modules.github.settings]
        remote = "dagger/dagger"
  """

  # Instructions for the PARENT agent holding these tools.
  let systemPrompt: String! = """
    You have GitHub tools: `reviewComments` for reading pull request review
    feedback, `ghApi` for read-only GitHub API queries, and `prComment` for
    leaving clearly agent-authored feedback.

    `ghApi` GETs any GitHub REST API path with authentication — code search
    ("search/code?q=repo:owner/name+needle"), PR/issue metadata, releases,
    CI check runs. Reach for it instead of fetching github.com web pages,
    which render as mostly navigation noise. Always pass a `jq` filter to
    keep the response small; raw payloads rarely fit in context.

    `reviewComments` reads the review comment threads on a pull request —
    each with its file, line, and diff context. Pass a PR number (resolved
    against the project's configured GitHub remote) or a full PR URL; the
    single-comment links people paste in conversation (ending in
    #discussion_r<id>) narrow the output to just that comment's thread. When
    asked to look at or address review feedback, read the thread first and
    act on what it actually says.

    `prComment` leaves feedback on a pull request: pass the PR and a body,
    plus optionally a file path (and line within the diff) to anchor it as
    a review comment. Comments posted this way are agent-authored, so the
    body must start with ":robot:" — the tool rejects it otherwise. Keep
    feedback kind, brief, and to-the-point.

  """
}
