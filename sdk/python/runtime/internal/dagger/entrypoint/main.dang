  let dispatch(platform: Platform!): File! {
    let ws = currentModule.contextDirectory.asWorkspace
    let src = currentModule.sourceSubpath
    let root = src
    let pkg = src
    go.module(ws, path: root, findUp: false).packages(ws).get(pkg).platforms.get(`${platform}`.split("/").takeFirst(2).join("/")).binary(ws)
