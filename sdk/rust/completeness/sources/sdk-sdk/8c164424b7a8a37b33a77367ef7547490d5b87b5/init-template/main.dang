"""
SDK helper module skeleton generated by sdk-sdk.

Implements the Dagger SDK authoring contract (CLI 1.0):

- `initModule` seeds the language-specific files for a new module. The engine
  owns dagger-module.toml and workspace config, so this returns only the SDK's
  own files.
- `generate` (a `@generate` hook) regenerates the modules this SDK manages.

Client generation (`initClient`) is intentionally not implemented; absence of
the function signals that this SDK does not author typed clients.
"""
type __SDK_NAME__ {
  """
  Stage the SDK-specific files for a new module at `path`.

  Returns only this SDK's files. The engine writes the module's
  dagger-module.toml and updates workspace config in the same init Changeset.
  """
  pub initModule(ws: Workspace!, name: String!, path: String! = "."): Changeset! {
    let seedPath = if (path == "" or path == ".") {
      "main.dang"
    } else {
      path.trimSuffix("/") + "/main.dang"
    }

    directory.withNewFile(seedPath, seed(name)).changes(directory)
  }

  """
  Regenerate the modules this SDK manages in the workspace.

  Discover managed modules with `currentModule.asSDK.modules` (each exposes its
  workspace-relative `path`) and return a Changeset of the regenerated files.

  TODO: implement generation for this SDK. Returning an empty Changeset is a
  no-op placeholder.
  """
  pub generate: Changeset! @generate {
    directory.changes(directory)
  }

  """
  Seed contents for a new module's main source file.

  TODO: replace with an idiomatic starter module for this SDK.
  """
  let seed(name: String!): String! {
    "\"\"\"\nA Dagger module named " + name + ".\n\"\"\"\ntype Main {\n}\n"
  }
}
